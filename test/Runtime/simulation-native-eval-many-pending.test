// RUN: %python %S/Inputs/gen-native-eval-many-pending.py > %t.sv
// RUN: obelisk --clocked-kernels=immediate -O3 --vpi=off --native-scheduler=eval --mlir-timing %t.sv -o %t.eval 2> %t.plan
// RUN: FileCheck %s --check-prefix=PLAN < %t.plan
// RUN: obelisk --clocked-kernels=immediate -O0 --vpi=off --native-scheduler=eval %t.sv -o %t.o0
// RUN: obelisk --clocked-kernels=immediate -O3 --vpi=read --native-scheduler=eval %t.sv -o %t.read
// RUN: obelisk --clocked-kernels=immediate -O3 --vpi=off --execution-tier=bytecode %t.sv -o %t.bytecode
// RUN: %t.bytecode > %t.reference
// RUN: %t.eval > %t.eval.out
// RUN: %t.o0 > %t.o0.out
// RUN: %t.read > %t.read.out
// RUN: diff -u %t.reference %t.eval.out
// RUN: diff -u %t.reference %t.o0.out
// RUN: diff -u %t.reference %t.read.out

// LRM 4.6(b), 4.9.4/10.4.2: last captures, partial targets, X/Z and skipped
// captures keep their semantics when more than 64 roots share an activation.
// A dynamic target stays canonical alongside private roots in its leaf word.
// PLAN: obelisk eval local pending roots: {{(6[5-9]|[7-9][0-9]|[1-9][0-9][0-9]+)}} cores=
// PLAN-SAME: bitmap-words=2
