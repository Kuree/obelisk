// REQUIRES: native-elf
// The wrappers observe actual installation/release of the emitted plan.
// RUN: talos-opt %S/../Conversion/simulation-ranked-group-proof-domain.mlir --pass-pipeline='builtin.module(simulation.design(simulation.func(talos-sim-thread-process-cfg),talos-sim-build-compute-graph,talos-sim-verify-compute-graph,talos-sim-materialize-graph-regions,talos-sim-materialize-compute-fusion,talos-sim-specialize-static-state-nba,talos-sim-plan-static-superstep),encode-talos-sim-to-bytecode{vpi=off},convert-talos-sim-processes-to-llvm-coroutines,materialize-runtime-byte-globals,test-talos-export-llvm-symbols{globals=__talos_state_value,__talos_state_unknown,__talos_eval_kernel_promotion_latched_v1,__talos_eval_group_promotion_latched_v1,__talos_eval_promotion_pending_mask_v1,__talos_eval_step_four_state_fallback_v1,__talos_aot_model_ingress_v1 main=model_main})' | talos-translate --mlir-to-llvmir -o %t.ll
// RUN: opt %t.ll -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O0>' -S -o %t.o0.ll && %target_cxx -O0 -I%S/../../runtime/include %t.o0.ll %S/Inputs/check-generated-group-proof-domain.cpp -Wl,--wrap=talos_rt_v1_scheduler_install_aot -Wl,--wrap=talos_rt_v1_context_destroy %runtime_link_flags -o %t.o0
// RUN: %t.o0 | FileCheck %s
// RUN: opt %t.ll -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' -S -o %t.o3.ll && %target_cxx -O3 -I%S/../../runtime/include %t.o3.ll %S/Inputs/check-generated-group-proof-domain.cpp -Wl,--wrap=talos_rt_v1_scheduler_install_aot -Wl,--wrap=talos_rt_v1_context_destroy %runtime_link_flags -o %t.o3
// RUN: %t.o3 | FileCheck %s

// CHECK: generated group domain integration passed
