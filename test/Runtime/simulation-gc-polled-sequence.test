// RUN: talos -emit-slang %S/../Conversion/simulation-gc-uvm-sequence.sv | talos-opt --test-talos-native-backend='scheduler=auto sim-opt-level=3 stop-after=lowering' -o %t.sim.mlir
// RUN: talos-opt %t.sim.mlir --pass-pipeline='builtin.module(talos-sim-insert-gc-polls,simulation.design(simulation.func(talos-sim-thread-suspension)),encode-talos-sim-to-bytecode{vpi=off prune-native=true},simulation.design(talos-sim-optimize-native-regions),simulation.design(talos-sim-plan-native-partitions),convert-talos-sim-processes-to-llvm-coroutines,materialize-runtime-byte-globals)' | talos-translate --mlir-to-llvmir | %llvm_dist/bin/opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' | %llc -filetype=obj -relocation-model=pic -o %t.polled-sequence.o
// RUN: %target_cxx %t.polled-sequence.o %runtime_link_flags -o %t.polled-sequence.exe
// RUN: env TALOS_RT_GC_THRESHOLD=256 TALOS_RT_GC_DIAGNOSTICS=1 %t.polled-sequence.exe 2>&1 | FileCheck %s --check-prefix=POLLED-SEQUENCE
// RUN: env TALOS_RT_GC_THRESHOLD=1 TALOS_RT_GC_DIAGNOSTICS=1 %t.polled-sequence.exe 2>&1 | FileCheck %s --check-prefix=POLLED-STRESS-SEQUENCE

// UVM-shaped class testbenches run with a GC threshold small enough that the
// heap collects many times. Every collection must keep each strongly
// reachable object (IEEE 1800-2023 8.29): handles in class fields, static
// members, queues, mailboxes, forked workers and suspended process frames.
// Under polled collection (talos-sim-insert-gc-polls) allocation never
// collects: activations root managed values only at polls and calls reaching
// one. A threshold of one byte reclaims at every such opportunity.
// POLLED-SEQUENCE: {{^}}total=570 kept=4 last=19{{$}}
// POLLED-SEQUENCE: talos-gc-diagnostics collections={{[1-9][0-9]*}} designated={{[1-9][0-9]*}} {{.*}} polled=1
// POLLED-STRESS-SEQUENCE: {{^}}total=570 kept=4 last=19{{$}}
// POLLED-STRESS-SEQUENCE: talos-gc-diagnostics collections={{[1-9][0-9]*}} {{.*}} polled=1
