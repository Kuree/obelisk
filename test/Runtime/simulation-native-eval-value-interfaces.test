// RUN: %python %S/Inputs/gen-native-eval-value-interfaces.py > %t.input.mlir
// RUN: obelisk-opt %t.input.mlir --obelisk-materialize-native-eval-groups -o %t.mlir
// RUN: mlir-translate --mlir-to-llvmir %t.mlir | %llvm_dist/bin/opt -passes='default<O0>' | %llc -filetype=obj -relocation-model=pic -o %t.o0.o
// RUN: %llvm_dist/bin/clang %S/Inputs/native-eval-value-interfaces.c %t.o0.o -o %t.o0.exe
// RUN: %t.o0.exe | FileCheck %s
// RUN: mlir-translate --mlir-to-llvmir %t.mlir | %llvm_dist/bin/opt -passes='default<O3>' | %llc -filetype=obj -relocation-model=pic -o %t.o3.o
// RUN: %llvm_dist/bin/clang %S/Inputs/native-eval-value-interfaces.c %t.o3.o -o %t.o3.exe
// RUN: %t.o3.exe | FileCheck %s
// CHECK: packed partial, conditional, observer and canonical ABI passed
