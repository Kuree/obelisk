// Runtime semantics for ../Conversion/simulation-scoped-force-state-runtime.mlir.

// RUN: talos-opt %S/../Conversion/simulation-scoped-force-state-runtime.mlir --pass-pipeline='builtin.module(simulation.design(talos-sim-build-compute-graph,talos-sim-verify-compute-graph,talos-sim-specialize-static-state-nba),encode-talos-sim-to-bytecode,convert-talos-sim-processes-to-llvm-coroutines)' | talos-translate --mlir-to-llvmir | %llvm_dist/bin/opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O0>' | %llc -filetype=obj -relocation-model=pic -o %t.o
// RUN: %target_cxx %t.o %runtime_link_flags -o %t.exe
// RUN: %t.exe | FileCheck %s

// CHECK: initial=x
// CHECK-NEXT: forced=z unrelated=9
// CHECK-NEXT: released=z unrelated=5
// CHECK-NEXT: written=5
