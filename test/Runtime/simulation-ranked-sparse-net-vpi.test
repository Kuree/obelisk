// RUN: obelisk-opt %S/../Conversion/simulation-ranked-sparse-net.mlir --pass-pipeline='builtin.module(simulation.design(simulation.func(obelisk-sim-thread-process-cfg),obelisk-sim-build-compute-graph{vpi=read},obelisk-sim-verify-compute-graph,obelisk-sim-materialize-graph-regions,obelisk-sim-materialize-compute-fusion,obelisk-sim-specialize-static-state-nba,obelisk-sim-plan-static-superstep),encode-obelisk-sim-to-bytecode{vpi=read},convert-obelisk-sim-processes-to-llvm-coroutines,materialize-runtime-byte-globals)' | obelisk-translate --mlir-to-llvmir | opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' -S -o %t.read.ll && %target_cxx -O3 %t.read.ll %runtime_link_flags -o %t.read.exe
// RUN: env OBELISK_RT_VERIFY_UNKNOWN_SUMMARY=1 %t.read.exe | FileCheck %s
// RUN: obelisk-opt %S/../Conversion/simulation-ranked-sparse-net.mlir --pass-pipeline='builtin.module(simulation.design(simulation.func(obelisk-sim-thread-process-cfg),obelisk-sim-build-compute-graph{vpi=full},obelisk-sim-verify-compute-graph,obelisk-sim-materialize-graph-regions,obelisk-sim-materialize-compute-fusion,obelisk-sim-specialize-static-state-nba,obelisk-sim-plan-static-superstep),encode-obelisk-sim-to-bytecode{vpi=full},convert-obelisk-sim-processes-to-llvm-coroutines,materialize-runtime-byte-globals)' | obelisk-translate --mlir-to-llvmir | opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' -S -o %t.full.ll && %target_cxx -O3 %t.full.ll %runtime_link_flags -o %t.full.exe
// RUN: env OBELISK_RT_VERIFY_UNKNOWN_SUMMARY=1 %t.full.exe | FileCheck %s

// Read-only and writable VPI modes retain the same four-state semantics.
// CHECK: sparse zzz1zzz0 result 10
// CHECK-NEXT: sparse zzz1zzz1 result 11
// CHECK-NEXT: sparse zzzxzzz1 result x1
// CHECK-NEXT: sparse zzzzzzz1 result z1
// CHECK-NEXT: sparse zzz0zzz1 result 01
