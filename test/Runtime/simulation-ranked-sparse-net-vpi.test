// RUN: talos-opt %S/../Conversion/simulation-ranked-sparse-net.mlir --pass-pipeline='builtin.module(simulation.design(simulation.func(talos-sim-thread-process-cfg),talos-sim-build-compute-graph{vpi=read},talos-sim-verify-compute-graph,talos-sim-materialize-graph-regions,talos-sim-materialize-compute-fusion,talos-sim-specialize-static-state-nba,talos-sim-plan-static-superstep),encode-talos-sim-to-bytecode{vpi=read},convert-talos-sim-processes-to-llvm-coroutines,materialize-runtime-byte-globals)' | talos-translate --mlir-to-llvmir | opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' -S -o %t.read.ll && %target_cxx -O3 %t.read.ll %runtime_link_flags -o %t.read.exe
// RUN: env TALOS_RT_VERIFY_UNKNOWN_SUMMARY=1 %t.read.exe | FileCheck %s
// RUN: talos-opt %S/../Conversion/simulation-ranked-sparse-net.mlir --pass-pipeline='builtin.module(simulation.design(simulation.func(talos-sim-thread-process-cfg),talos-sim-build-compute-graph{vpi=full},talos-sim-verify-compute-graph,talos-sim-materialize-graph-regions,talos-sim-materialize-compute-fusion,talos-sim-specialize-static-state-nba,talos-sim-plan-static-superstep),encode-talos-sim-to-bytecode{vpi=full},convert-talos-sim-processes-to-llvm-coroutines,materialize-runtime-byte-globals)' | talos-translate --mlir-to-llvmir | opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' -S -o %t.full.ll && %target_cxx -O3 %t.full.ll %runtime_link_flags -o %t.full.exe
// RUN: env TALOS_RT_VERIFY_UNKNOWN_SUMMARY=1 %t.full.exe | FileCheck %s

// Read-only and writable VPI modes retain the same four-state semantics.
// CHECK: sparse zzz1zzz0 result 10
// CHECK-NEXT: sparse zzz1zzz1 result 11
// CHECK-NEXT: sparse zzzxzzz1 result x1
// CHECK-NEXT: sparse zzzzzzz1 result z1
// CHECK-NEXT: sparse zzz0zzz1 result 01
