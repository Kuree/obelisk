// Runtime semantics for ../Conversion/simulation-controlled-pass-delay-runtime.mlir.

// RUN: talos-opt %S/../Conversion/simulation-controlled-pass-delay-runtime.mlir --pass-pipeline='builtin.module(simulation.design(talos-sim-build-compute-graph,talos-sim-verify-compute-graph),encode-talos-sim-to-bytecode{vpi=off require-bytecode=true},convert-talos-sim-processes-to-llvm-coroutines)'  | talos-translate --mlir-to-llvmir | %llvm_dist/bin/opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O0>' | %llc -filetype=obj -relocation-model=pic -o %t.o
// RUN: %target_cxx %t.o %runtime_link_flags -o %t.exe
// RUN: %t.exe --execution-tier=native | FileCheck %s
// RUN: %t.exe --execution-tier=bytecode | FileCheck %s

// CHECK: initial StH
// CHECK-NEXT: before-on StH
// CHECK-NEXT: enabled St1
// CHECK-NEXT: before-off St1
// CHECK-NEXT: disabled HiZ
// CHECK-NEXT: rejected HiZ
// CHECK-NEXT: unknown StH
