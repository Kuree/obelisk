// RUN: obelisk -emit-slang %S/../Conversion/simulation-gc-uvm-mailbox.sv | obelisk-opt --test-obelisk-native-backend='scheduler=auto sim-opt-level=3 stop-after=lowering' '--test-obelisk-set-module-attributes=attrs="{schedule.native_scheduler = 1 : i32}"' -o %t.sim.mlir
// RUN: obelisk-opt %t.sim.mlir --pass-pipeline='builtin.module(simulation.design(obelisk-sim-plan-native-partitions),convert-obelisk-sim-processes-to-llvm-coroutines,materialize-runtime-byte-globals)' | obelisk-translate --mlir-to-llvmir | %llvm_dist/bin/opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' | %llc -filetype=obj -relocation-model=pic -o %t.mailbox.o
// RUN: %target_cxx %t.mailbox.o %runtime_link_flags -o %t.mailbox.exe
// RUN: env OBELISK_RT_GC_THRESHOLD=256 OBELISK_RT_GC_DIAGNOSTICS=1 %t.mailbox.exe 2>&1 | FileCheck %s --check-prefix=MAILBOX

// UVM-shaped class testbenches run with a GC threshold small enough that the
// heap collects many times. Every collection must keep each strongly
// reachable object (IEEE 1800-2023 8.29): handles in class fields, static
// members, queues, mailboxes, forked workers and suspended process frames.
// Without a periodic clock, allocation keeps collecting. Sixteen packets go
// through the mailbox; every forked worker reads its own captured handle after
// a clock wait, and the static registry still reaches the whole history.
// MAILBOX: {{^}}checksum=576 history=120 depth=16 last=15{{$}}
// MAILBOX: obelisk-gc-diagnostics collections={{[1-9][0-9]*}} designated=0 {{.*}} polled=0
