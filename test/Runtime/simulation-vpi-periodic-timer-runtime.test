// REQUIRES: native-elf
// The harness interposes runtime calls with the ELF linker's --wrap option.
// RUN: talos-opt %S/../Conversion/simulation-vpi-periodic-timer-runtime.mlir --pass-pipeline='builtin.module(simulation.design(simulation.func(talos-sim-thread-suspension),talos-sim-build-compute-graph{vpi=full},talos-sim-verify-compute-graph,talos-sim-materialize-graph-regions,talos-sim-materialize-compute-fusion,talos-sim-specialize-static-state-nba,talos-sim-plan-static-superstep),encode-talos-sim-to-bytecode{vpi=full},convert-talos-sim-processes-to-llvm-coroutines)' | talos-translate --mlir-to-llvmir | %llvm_dist/bin/opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' | %llc -filetype=obj -relocation-model=pic -o %t.o
// RUN: %llvm_dist/bin/clang -I%S/../Conversion/../../runtime/include -I%resource_dir/include -c %S/Inputs/vpi-periodic-timer.c -o %t.helper.o
// RUN: %target_cxx %t.o %t.helper.o -Wl,--wrap=talos_rt_v1_scheduler_run -Wl,--wrap=talos_rt_v1_scheduler_run_aot %runtime_link_flags -o %t.exe
// RUN: env TALOS_RT_SIGNAL_DIAGNOSTICS=1 %t.exe > %t.out 2> %t.diag
// RUN: FileCheck %s < %t.out
// RUN: FileCheck %s --check-prefix=TIERS < %t.diag

// Runtime semantics for ../Conversion/simulation-vpi-periodic-timer-runtime.mlir.

// TIERS: aot_node_executions=3
// TIERS-SAME: aot_nba_stages=0
// TIERS-SAME: aot_fallbacks=0
// CHECK: periodic timer time=7 count=1
// CHECK-NEXT: periodic timer time=10007 count=1001
// CHECK-NEXT: periodic timer time=20007 count=2001
