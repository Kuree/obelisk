// RUN: talos-opt %S/Inputs/op-canonicalization-forms.mlir --canonicalize --convert-talos-sim-values-to-standard --canonicalize | %llvm_dist/bin/mlir-opt --convert-math-to-llvm --convert-arith-to-llvm --convert-func-to-llvm --reconcile-unrealized-casts | talos-translate --mlir-to-llvmir > %t.canonical.ll
// RUN: talos-opt %S/Inputs/op-canonicalization-forms.mlir --canonicalize="top-down=false" --convert-talos-sim-values-to-standard --canonicalize | %llvm_dist/bin/mlir-opt --convert-math-to-llvm --convert-arith-to-llvm --convert-func-to-llvm --reconcile-unrealized-casts | talos-translate --mlir-to-llvmir > %t.bottom-up.ll
// RUN: talos-opt %S/Inputs/op-canonicalization-forms.mlir --test-talos-prefix-symbols=prefix=reference_ --convert-talos-sim-values-to-standard --canonicalize | %llvm_dist/bin/mlir-opt --convert-math-to-llvm --convert-arith-to-llvm --convert-func-to-llvm --reconcile-unrealized-casts | talos-translate --mlir-to-llvmir > %t.reference.ll
// RUN: %llvm_dist/bin/clang++ -O0 %t.canonical.ll %t.reference.ll %S/Inputs/op-canonicalization-forms.cpp -o %t.exe
// RUN: %t.exe | FileCheck %s
// RUN: %llvm_dist/bin/clang++ -O0 %t.bottom-up.ll %t.reference.ll %S/Inputs/op-canonicalization-forms.cpp -o %t.bottom-up.exe
// RUN: %t.bottom-up.exe | FileCheck %s

// IEEE 1800-2023 11.4, 11.5.1, 11.6.1, 12.4 and 20.9: every canonical form
// must agree with the reference lowering on every pair of four-bit four-state
// values, including X and Z kept distinct, with both traversal orders.
// CHECK: PASS: {{[0-9]+}} functions, 65536 four-state pairs
