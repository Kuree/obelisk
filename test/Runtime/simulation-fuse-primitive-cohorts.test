// Runtime semantics for ../Conversion/simulation-fuse-primitive-cohorts.mlir.

// RUN: %split-file %S/../Conversion/simulation-fuse-primitive-cohorts.mlir %t
// RUN: talos-opt %t/cyclic.mlir --pass-pipeline='builtin.module(simulation.design(simulation.func(talos-sim-thread-suspension),talos-sim-build-compute-graph,talos-sim-fuse-compute-fragments{body-fusion=true primitive-only=true max-straight-line-members=64},talos-sim-materialize-compute-fusion,talos-sim-build-compute-graph),encode-talos-sim-to-bytecode{vpi=off require-bytecode=true},convert-talos-sim-processes-to-llvm-coroutines)' | talos-translate --mlir-to-llvmir | %llvm_dist/bin/opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup' | %llc -filetype=obj -relocation-model=pic -o %t.cycle.o
// RUN: %target_cxx %t.cycle.o %runtime_link_flags -o %t.cycle.exe
// RUN: %t.cycle.exe --execution-tier=native
// RUN: %t.cycle.exe --execution-tier=bytecode
