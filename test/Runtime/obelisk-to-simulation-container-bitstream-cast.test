// RUN: %llvm_dist/bin/llvm-nm -C --defined-only %t.exe | FileCheck %s --check-prefix=BYTECODE-LINK '--implicit-check-not={{ [TtW] .*}}recursive_bitstream' '--implicit-check-not={{ [TtW] .*}}v{{[0-9]+}}_recursive_export' %if !native-macho %{ '--implicit-check-not={{ [TtW] .*}}expand_recursive' %}
// RUN: not %t.exe --execution-tier=native 2>&1 | FileCheck %s --check-prefix=FATAL
// RUN: not %t.exe --execution-tier=bytecode 2>&1 | FileCheck %s --check-prefix=FATAL
// RUN: obelisk-opt %S/../Conversion/obelisk-to-simulation-container-bitstream-cast.mlir '--lower-obelisk-to-sim=opt-level=0' --convert-obelisk-sim-processes-to-llvm-coroutines | obelisk-translate --mlir-to-llvmir | %llc -filetype=obj -relocation-model=pic -o %t.native.o
// RUN: %target_cxx %t.native.o %runtime_link_flags -o %t.native.exe
// RUN: %llvm_dist/bin/llvm-nm -C --defined-only %t.native.exe | FileCheck %s --check-prefix=NATIVE-LINK '--implicit-check-not={{ [TtW] .*}}container_bitstream_link_anchor' '--implicit-check-not={{ [TtW] .*}}recursive_bitstream' '--implicit-check-not={{ [TtW] .*}}v{{[0-9]+}}_recursive_export' %if !native-macho %{ '--implicit-check-not={{ [TtW] .*}}invokeContainerBitstreamIntrinsic' '--implicit-check-not={{ [TtW] .*}}expand_recursive' %}

