// REQUIRES: native-elf
// The harness interposes runtime calls with the ELF linker's --wrap option.
// Runtime semantics for ../Conversion/simulation-vpi-write-tier2-runtime.mlir.

// RUN: talos-opt %S/../Conversion/simulation-vpi-write-tier2-runtime.mlir --pass-pipeline='builtin.module(simulation.design(simulation.func(talos-sim-thread-suspension),talos-sim-build-compute-graph{vpi=full},talos-sim-verify-compute-graph,talos-sim-materialize-graph-regions,talos-sim-materialize-compute-fusion,talos-sim-specialize-static-state-nba,talos-sim-plan-static-superstep),encode-talos-sim-to-bytecode{vpi=full prune-native=true},convert-talos-sim-processes-to-llvm-coroutines)' -o %t.llvm.mlir
// RUN: talos-translate --mlir-to-llvmir %t.llvm.mlir | %llvm_dist/bin/opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' | %llc -filetype=obj -relocation-model=pic -o %t.o
// RUN: %llvm_dist/bin/clang -I%S/../Conversion/../../runtime/include -I%resource_dir/include -c %S/Inputs/vpi-write-tier1.c -o %t.helper.o
// RUN: %target_cxx %t.o %t.helper.o -Wl,--wrap=talos_rt_v1_scheduler_run_aot -Wl,--wrap=talos_rt_v1_display %runtime_link_flags -o %t.exe
// RUN: env TALOS_RT_SIGNAL_DIAGNOSTICS=1 %t.exe > %t.out 2> %t.diag
// RUN: FileCheck %s < %t.out
// RUN: env TALOS_TEST_IMMEDIATE_NET_RELEASE=1 %t.exe | FileCheck %s

// CHECK: before 0 000001f4
// CHECK-NEXT: after 0 00000029
// CHECK-NEXT: before 1 0000002a
// CHECK-NEXT: after 1 00000007
// CHECK-NEXT: before 2 00000007
// CHECK-NEXT: after 2 00000007
// CHECK-NEXT: before 3 00000008
// CHECK-NEXT: after 3 xxxxxxxx
// CHECK-NEXT: before 4 xxxxxxxx
// CHECK-NEXT: after 4 00000000
// CHECK-NEXT: before 5 00000001
// CHECK-NEXT: after 5 00000001 net=00000037
// CHECK-NEXT: before 6 00000002
// CHECK-NEXT: after 6 00000002 net=00000002
// CHECK-NEXT: done 000001f6 net=000001f6
