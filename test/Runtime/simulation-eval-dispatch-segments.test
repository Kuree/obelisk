// RUN: %target_cxx -std=c++17 -O0 -DORDERED_NBA -I %S/../../runtime/include %t.ordered.ll %S/Inputs/check-eval-dispatch-segments.cpp %runtime_link_flags -o %t.ordered.exe
// RUN: %t.ordered.exe | FileCheck %s --check-prefix=ORDERED

// Execute the generated segment functions directly, controlling their ingress
// and termination state to exercise boundaries independent of clock startup.
// SPARSE: segment ready selection and handoffs passed
// SPARSE-NOT: {{.}}
// ORDERED: ordered NBA error handoff passed
// ORDERED-NEXT: 00000000000000000 1
// ORDERED-NOT: {{.}}
