// RUN: %python %S/Inputs/gen-wide-inert-nba.py > %t.mlir
// RUN: obelisk-opt %t.mlir --pass-pipeline='builtin.module(simulation.design(simulation.func(obelisk-sim-thread-process-cfg),obelisk-sim-build-compute-graph,obelisk-sim-verify-compute-graph,obelisk-sim-materialize-graph-regions,obelisk-sim-materialize-compute-fusion,obelisk-sim-specialize-static-state-nba,obelisk-sim-plan-static-superstep),encode-obelisk-sim-to-bytecode{vpi=off},convert-obelisk-sim-processes-to-llvm-coroutines)' -o %t.llvm.mlir 2>&1 | FileCheck %s --check-prefix=PROOF
// RUN: FileCheck %s --check-prefix=PLAN < %t.llvm.mlir
// RUN: obelisk-opt %t.llvm.mlir --materialize-runtime-byte-globals -o %t.final.mlir
// RUN: mlir-translate --mlir-to-llvmir %t.final.mlir | %llvm_dist/bin/opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' | %llc -filetype=obj -relocation-model=pic -o %t.o
// RUN: %llvm_dist/bin/clang++ %t.o %native_support/libobelisk_rt.a %native_support/libc++.a %native_support/libc++abi.a %native_support/libunwind.a -nostdlib++ -lpthread -ldl -o %t.exe
// RUN: %t.exe --execution-tier=native | FileCheck %s
// RUN: %t.exe --execution-tier=bytecode | FileCheck %s

// Holds wider than one machine word may skip staging only when both planes
// match and no earlier update is pending. Keep actual semantic NBA barriers.
// PROOF: obelisk native unchanged NBA roots: 128/128
// PLAN-LABEL: llvm.func @writer1.__obelisk_eval_body_0(
// PLAN: llvm.mlir.addressof @__obelisk_aot_nba_dirty_roots_v1
// PLAN: llvm.icmp "ne"
// PLAN: llvm.cond_br
// PLAN: llvm.mlir.addressof @__obelisk_eval_nba_valid_
// PLAN: llvm.return
// CHECK: active 0 127 1.000000
// CHECK-NEXT: settled 1 127 pending=1
// CHECK-NEXT: active 1 127 1.000000
// CHECK-NEXT: settled 2 127 pending=1
// CHECK-NEXT: active 2 127 1.000000
// CHECK-NEXT: settled 3 127 pending=1
// CHECK-NEXT: active 3 127 1.000000
// CHECK-NEXT: settled 4 127 pending=1
