// Runtime semantics for ../Conversion/simulation-controlled-pass-runtime.mlir.

// RUN: talos-opt %S/../Conversion/simulation-controlled-pass-runtime.mlir --pass-pipeline='builtin.module(simulation.design(talos-sim-build-compute-graph,talos-sim-verify-compute-graph),encode-talos-sim-to-bytecode{vpi=off require-bytecode=true},convert-talos-sim-processes-to-llvm-coroutines)' | talos-translate --mlir-to-llvmir | %llc -filetype=obj -relocation-model=pic -o %t.o
// RUN: %target_cxx %t.o %runtime_link_flags -o %t.exe
// RUN: %t.exe --execution-tier=bytecode | FileCheck %s
// RUN: %t.exe --execution-tier=native | FileCheck %s

// CHECK: enabled Su1 St1 Pu1
// CHECK: disabled Su1 HiZ HiZ
// CHECK: x-control Su1 StH PuH
// CHECK: z-control Su1 StH PuH
// CHECK: reverse Pu0 Pu0 Su0
// CHECK: array 0101
