// RUN: talos-opt %S/../Dialect/Simulation/Transforms/simulation-unroll-logic-induction.mlir --pass-pipeline='builtin.module(encode-talos-sim-to-bytecode{vpi=off},convert-talos-sim-processes-to-llvm-coroutines,materialize-runtime-byte-globals)' | talos-translate --mlir-to-llvmir -o %t.loop.ll
// RUN: talos-opt %S/../Dialect/Simulation/Transforms/simulation-unroll-logic-induction.mlir --pass-pipeline='builtin.module(simulation.design(simulation.func(talos-sim-unroll-bounded-loops,canonicalize,cse)),encode-talos-sim-to-bytecode{vpi=off},convert-talos-sim-processes-to-llvm-coroutines,materialize-runtime-byte-globals)' | talos-translate --mlir-to-llvmir -o %t.unrolled.ll
// RUN: opt %t.loop.ll -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O0>' -S -o %t.loop.o0.ll
// RUN: %target_cxx -O0 %t.loop.o0.ll %runtime_link_flags -o %t.loop.exe && %t.loop.exe > %t.loop.out && FileCheck %s < %t.loop.out
// RUN: opt %t.unrolled.ll -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O0>' -S -o %t.unrolled.o0.ll
// RUN: %target_cxx -O0 %t.unrolled.o0.ll %runtime_link_flags -o %t.o0.exe && %t.o0.exe | diff -u %t.loop.out -
// RUN: opt %t.unrolled.ll -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' -S -o %t.unrolled.o3.ll
// RUN: %target_cxx -O3 %t.unrolled.o3.ll %runtime_link_flags -o %t.o3.exe && %t.o3.exe | diff -u %t.loop.out -

// Exact observer order, signed induction, zero-trip effects and unsigned
// high-bit values. Packed writes retain both X/Z bits, observe earlier
// iterations through aliased source/destination references, and preserve
// the untouched adjacent 79-bit element (LRM 4.6, 11.6.1, 12.7.1).
// CHECK: visit 01
// CHECK-NEXT: visit ff
// CHECK-NEXT: visit fd
// CHECK-NEXT: visit fd
// CHECK-NEXT: visit ff
// CHECK-NEXT: visit 01
// CHECK-NEXT: visit fa
// CHECK-NEXT: visit fb
// CHECK-NEXT: visit fc
// CHECK-NEXT: packed 1
// CHECK-NEXT: packed 1
// CHECK-NEXT: packed 1
// CHECK-NEXT: packed 1
// CHECK-NEXT: packed 1
// CHECK-NEXT: packed 1
// CHECK-NEXT: packed 1
// CHECK-NOT: {{.}}
