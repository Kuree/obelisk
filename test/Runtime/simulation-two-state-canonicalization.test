// RUN: obelisk-opt %S/Inputs/two-state-canonicalization.mlir --canonicalize --convert-obelisk-sim-values-to-standard --canonicalize | %llvm_dist/bin/mlir-opt --convert-arith-to-llvm --convert-func-to-llvm --reconcile-unrealized-casts | mlir-translate --mlir-to-llvmir > %t.canonical.ll
// RUN: sed -e 's/@arithmetic/@reference_arithmetic/' -e 's/@comparisons/@reference_comparisons/' -e 's/@parameter/@reference_parameter/' %S/Inputs/two-state-canonicalization.mlir | obelisk-opt --convert-obelisk-sim-values-to-standard --canonicalize | %llvm_dist/bin/mlir-opt --convert-arith-to-llvm --convert-func-to-llvm --reconcile-unrealized-casts | mlir-translate --mlir-to-llvmir > %t.reference.ll
// RUN: %llvm_dist/bin/clang++ -O0 %t.canonical.ll %t.reference.ll %S/Inputs/two-state-canonicalization.cpp -o %t.exe
// RUN: %t.exe | FileCheck %s
// RUN: %llvm_dist/bin/clang++ -O3 %t.canonical.ll %t.reference.ll %S/Inputs/two-state-canonicalization.cpp -o %t.o3.exe
// RUN: %t.o3.exe | FileCheck %s
// CHECK: PASS: 65536 operand pairs and 256 parameter indices
