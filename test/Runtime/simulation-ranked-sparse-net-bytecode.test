// RUN: talos-opt %S/../Conversion/simulation-ranked-sparse-net.mlir --pass-pipeline='builtin.module(test-talos-set-module-attributes{attrs="{schedule.native_scheduler = 1 : i32}"},simulation.design(simulation.func(talos-sim-thread-process-cfg),talos-sim-build-compute-graph{vpi=off},talos-sim-verify-compute-graph,talos-sim-materialize-graph-regions,talos-sim-materialize-compute-fusion,talos-sim-specialize-static-state-nba,talos-sim-plan-static-superstep),encode-talos-sim-to-bytecode{vpi=off require-bytecode=true},convert-talos-sim-processes-to-llvm-coroutines,materialize-runtime-byte-globals)' -o %t.mlir
// RUN: FileCheck %s --check-prefix=BYTECODE --implicit-check-not=__talos_eval_ranked_group_ < %t.mlir
// RUN: talos-translate %t.mlir --mlir-to-llvmir -o %t.ll
// RUN: opt %t.ll -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O0>' -S -o %t.o0.ll && %target_cxx -O0 %t.o0.ll %runtime_link_flags -o %t.o0.exe && %t.o0.exe | FileCheck %s
// RUN: opt %t.ll -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' -S -o %t.o3.ll && %target_cxx -O3 %t.o3.ll %runtime_link_flags -o %t.o3.exe && %t.o3.exe | FileCheck %s
// RUN: talos-opt %S/../Conversion/simulation-ranked-sparse-net.mlir --pass-pipeline='builtin.module(test-talos-set-module-attributes{attrs="{schedule.native_scheduler = 1 : i32}"},simulation.design(simulation.func(talos-sim-thread-process-cfg),talos-sim-build-compute-graph{vpi=read},talos-sim-verify-compute-graph,talos-sim-materialize-graph-regions,talos-sim-materialize-compute-fusion,talos-sim-specialize-static-state-nba,talos-sim-plan-static-superstep),encode-talos-sim-to-bytecode{vpi=read require-bytecode=true},convert-talos-sim-processes-to-llvm-coroutines,materialize-runtime-byte-globals)' | talos-translate --mlir-to-llvmir | opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' -S -o %t.read.ll && %target_cxx -O3 %t.read.ll %runtime_link_flags -o %t.read.exe && %t.read.exe | FileCheck %s
// RUN: talos-opt %S/../Conversion/simulation-ranked-sparse-net.mlir --pass-pipeline='builtin.module(test-talos-set-module-attributes{attrs="{schedule.native_scheduler = 1 : i32}"},simulation.design(simulation.func(talos-sim-thread-process-cfg),talos-sim-build-compute-graph{vpi=full},talos-sim-verify-compute-graph,talos-sim-materialize-graph-regions,talos-sim-materialize-compute-fusion,talos-sim-specialize-static-state-nba,talos-sim-plan-static-superstep),encode-talos-sim-to-bytecode{vpi=full require-bytecode=true},convert-talos-sim-processes-to-llvm-coroutines,materialize-runtime-byte-globals)' | talos-translate --mlir-to-llvmir | opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' -S -o %t.full.ll && %target_cxx -O3 %t.full.ll %runtime_link_flags -o %t.full.exe && %t.full.exe | FileCheck %s

// Required-bytecode execution is selected during lowering. A runtime argv
// --execution-tier flag does not select a tier in directly linked MLIR models.
// Generic scheduling and require-bytecode exercise an independent interpreter
// path with the same sparse X/Z transitions used by the native fixture.
// The descriptor carries Bytecode (1) | RequireBytecode (16).
// BYTECODE-LABEL: llvm.mlir.global external constant @__talos_execution_descriptor_v1()
// BYTECODE: %[[FLAGS:.*]] = llvm.mlir.constant(17 : i32)
// BYTECODE-NEXT: llvm.insertvalue %[[FLAGS]], {{.*}}[1]
// BYTECODE-LABEL: llvm.func @main(
// BYTECODE: llvm.call @talos_rt_v1_scheduler_run
// CHECK: sparse zzz1zzz0 result 10
// CHECK-NEXT: sparse zzz1zzz1 result 11
// CHECK-NEXT: sparse zzzxzzz1 result x1
// CHECK-NEXT: sparse zzzzzzz1 result z1
// CHECK-NEXT: sparse zzz0zzz1 result 01
