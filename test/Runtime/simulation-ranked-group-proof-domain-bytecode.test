// RUN: obelisk-opt %S/../Conversion/simulation-ranked-group-proof-domain.mlir --pass-pipeline='builtin.module(test-obelisk-set-module-attributes{attrs="{schedule.native_scheduler = 1 : i32}"},simulation.design(simulation.func(obelisk-sim-thread-process-cfg),obelisk-sim-build-compute-graph,obelisk-sim-verify-compute-graph,obelisk-sim-materialize-graph-regions,obelisk-sim-materialize-compute-fusion,obelisk-sim-specialize-static-state-nba,obelisk-sim-plan-static-superstep),encode-obelisk-sim-to-bytecode{vpi=off require-bytecode=true},convert-obelisk-sim-processes-to-llvm-coroutines,materialize-runtime-byte-globals)' -o %t.mlir
// RUN: FileCheck %s --implicit-check-not=__obelisk_eval_ranked_group_ < %t.mlir
// RUN: obelisk-translate --mlir-to-llvmir %t.mlir -o %t.ll
// RUN: opt %t.ll -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' -S -o %t.o3.ll && %target_cxx -O3 %t.o3.ll %runtime_link_flags -o %t.o3
// RUN: %t.o3 | FileCheck %S/simulation-ranked-group-proof-domain.test
// RUN: opt %t.ll -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O0>' -S -o %t.o0.ll && %target_cxx -O0 %t.o0.ll %runtime_link_flags -o %t.o0
// RUN: %t.o0 | FileCheck %S/simulation-ranked-group-proof-domain.test

// This must actually invoke the interpreter; runtime command-line tier flags
// cannot establish bytecode execution of an already-native generated main.
// CHECK: llvm.mlir.constant(17 : i32)
// CHECK-LABEL: llvm.func @main(
// CHECK-NOT: __obelisk_eval_group_promotion
// CHECK: llvm.call @obelisk_rt_v1_scheduler_run
