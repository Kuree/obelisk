// RUN: talos-opt %S/../Conversion/simulation-periodic-copy-tree.mlir --pass-pipeline='builtin.module(simulation.design(simulation.func(talos-sim-thread-process-cfg),talos-sim-build-compute-graph,talos-sim-verify-compute-graph,talos-sim-materialize-graph-regions,talos-sim-materialize-compute-fusion,talos-sim-specialize-static-state-nba,talos-sim-plan-static-superstep),encode-talos-sim-to-bytecode{vpi=off},convert-talos-sim-processes-to-llvm-coroutines,materialize-runtime-byte-globals)' | talos-translate --mlir-to-llvmir -o %t.ll
// RUN: opt %t.ll -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O0>' -S -o %t.o0.ll
// RUN: %target_cxx -O0 %t.o0.ll %runtime_link_flags -o %t.o0.exe && %t.o0.exe | FileCheck %s
// RUN: opt %t.ll -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' -S -o %t.o3.ll
// RUN: %target_cxx -O3 %t.o3.ll %runtime_link_flags -o %t.o3.exe && %t.o3.exe | FileCheck %s

// RUN: talos-opt %S/../Conversion/simulation-periodic-copy-tree.mlir --pass-pipeline='builtin.module(simulation.design(simulation.func(talos-sim-thread-process-cfg),talos-sim-build-compute-graph{vpi=read},talos-sim-verify-compute-graph,talos-sim-materialize-graph-regions,talos-sim-materialize-compute-fusion,talos-sim-specialize-static-state-nba,talos-sim-plan-static-superstep),encode-talos-sim-to-bytecode{vpi=read},convert-talos-sim-processes-to-llvm-coroutines,materialize-runtime-byte-globals)' | talos-translate --mlir-to-llvmir | opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' -S -o %t.read.ll
// RUN: %target_cxx -O3 %t.read.ll %runtime_link_flags -o %t.read.exe && %t.read.exe | FileCheck %s

// Both handoffs restore the canonical driver, and evaluation resumes after
// the first callback. The falling edge also updates the net with no negedge
// consumers (IEEE 1800-2023 4.9.1, 9.4.2).
// CHECK: count=2 level=1 driver=1
// CHECK-NEXT: count=3 level=0 driver=0
