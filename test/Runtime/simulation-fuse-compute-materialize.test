// Runtime semantics for ../Conversion/simulation-fuse-compute-materialize.mlir.

// RUN: %split-file %S/../Conversion/simulation-fuse-compute-materialize.mlir %t
// RUN: obelisk -O3 --native-scheduler=generic %t/materialize.sv -o %t/generic
// RUN: obelisk -O3 --native-scheduler=aot %t/materialize.sv -o %t/aot
// RUN: %t/generic > %t/generic.out
// RUN: %t/aot > %t/aot.out
// RUN: diff %t/generic.out %t/aot.out
