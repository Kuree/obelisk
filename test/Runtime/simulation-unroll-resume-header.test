// RUN: obelisk-opt %S/../Dialect/Simulation/Transforms/simulation-unroll-resume-header.mlir --pass-pipeline='builtin.module(simulation.design(simulation.func(obelisk-sim-thread-process-cfg)),encode-obelisk-sim-to-bytecode{vpi=off},convert-obelisk-sim-processes-to-llvm-coroutines,materialize-runtime-byte-globals)' | obelisk-translate --mlir-to-llvmir -o %t.loop.ll
// RUN: obelisk-opt %S/../Dialect/Simulation/Transforms/simulation-unroll-resume-header.mlir --pass-pipeline='builtin.module(simulation.design(simulation.func(obelisk-sim-unroll-bounded-loops,obelisk-sim-thread-process-cfg)),encode-obelisk-sim-to-bytecode{vpi=off},convert-obelisk-sim-processes-to-llvm-coroutines,materialize-runtime-byte-globals)' | obelisk-translate --mlir-to-llvmir -o %t.unrolled.ll
// RUN: opt %t.loop.ll -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O0>' -S -o %t.loop.o0.ll
// RUN: %target_cxx -O0 %t.loop.o0.ll %runtime_link_flags -o %t.loop.exe && %t.loop.exe > %t.loop.out && FileCheck %s < %t.loop.out && %t.loop.exe +alternate > %t.alternate.out && FileCheck %s --check-prefix=ALTERNATE < %t.alternate.out
// RUN: opt %t.unrolled.ll -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O0>' -S -o %t.unrolled.o0.ll
// RUN: %target_cxx -O0 %t.unrolled.o0.ll %runtime_link_flags -o %t.o0.exe && %t.o0.exe | diff -u %t.loop.out - && %t.o0.exe +alternate | diff -u %t.alternate.out -
// RUN: opt %t.unrolled.ll -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' -S -o %t.unrolled.o3.ll
// RUN: %target_cxx -O3 %t.unrolled.o3.ll %runtime_link_flags -o %t.o3.exe && %t.o3.exe | diff -u %t.loop.out - && %t.o3.exe +alternate | diff -u %t.alternate.out -

// Each of three activations resets both inductions, carries the phase through
// two resumes, and publishes the nested-loop writes in source order.
// CHECK: visit 0
// CHECK-NEXT: visit 1
// CHECK-NEXT: visit 10
// CHECK-NEXT: visit 11
// CHECK-NEXT: visit 100
// CHECK-NEXT: visit 101
// CHECK-NEXT: visit 110
// CHECK-NEXT: visit 111
// CHECK-NEXT: visit 200
// CHECK-NEXT: visit 201
// CHECK-NEXT: visit 210
// CHECK-NEXT: visit 211
// CHECK-NOT: {{.}}

// The other conditional edge carries 1000 through the same new preheader.
// Each invocation has just one worker, so this checks no interprocess order.
// ALTERNATE: visit 1000
// ALTERNATE-NEXT: visit 1001
// ALTERNATE-NEXT: visit 1010
// ALTERNATE-NEXT: visit 1011
// ALTERNATE-NOT: {{.}}
