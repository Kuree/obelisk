  %t12 = simulation.logic.extract %t11 from 0 : !simulation.logic<8> -> !simulation.logic<4>
  %t13 = func.call @encode(%t12) : (!simulation.logic<4>) -> i8
  %t14 = simulation.logic.extract %t11 from 4 : !simulation.logic<8> -> !simulation.logic<4>
  %t15 = func.call @encode(%t14) : (!simulation.logic<4>) -> i8
  %r0 = arith.extui %t3 : i8 to i64
  %s0 = arith.constant 0 : i64
  %q0 = arith.shli %r0, %s0 : i64
  %r1 = arith.extui %t5 : i8 to i64
