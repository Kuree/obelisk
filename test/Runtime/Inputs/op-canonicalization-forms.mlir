func.func @two_state_more(%a: i8, %b: i8) -> i64 {
  %x = func.call @decode(%a) : (i8) -> !simulation.logic<4>
  %y = func.call @decode(%b) : (i8) -> !simulation.logic<4>
  %x1 = simulation.logic.extract %x from 0 : !simulation.logic<4> -> !simulation.logic<1>
  %y1 = simulation.logic.extract %y from 0 : !simulation.logic<4> -> !simulation.logic<1>
  %c1 = simulation.logic.extract %y from 1 : !simulation.logic<4> -> !simulation.logic<1>
  %na = arith.trunci %a : i8 to i4
  %nb = arith.trunci %b : i8 to i4
  %kx = simulation.logic.from_bits %na : i4 -> !simulation.logic<4>
  %ky = simulation.logic.from_bits %nb : i4 -> !simulation.logic<4>
  %xy = simulation.logic.concat %x, %y : (!simulation.logic<4>, !simulation.logic<4>) -> !simulation.logic<8>
  %xyand = simulation.logic.binary and %x, %y : !simulation.logic<4>
  %t0 = simulation.logic.constant 15 : i4, 0 : i4 : !simulation.logic<4>
  %t1 = simulation.logic.binary smod %kx, %t0 : !simulation.logic<4>
  %t2 = func.call @encode(%t1) : (!simulation.logic<4>) -> i8
  %t3 = simulation.logic.extract %kx from 0 : !simulation.logic<4> -> !simulation.logic<2>
  %t4 = simulation.logic.resize %t3 signed = false : !simulation.logic<2> -> !simulation.logic<4>
  %t5 = func.call @encode(%t4) : (!simulation.logic<4>) -> i8
  %t6 = arith.trunci %b : i8 to i3
  %t7 = simulation.logic.extract %ky from 0 : !simulation.logic<4> -> !simulation.logic<2>
  %t8 = simulation.logic.dyn_insert %t7 into %kx at %t6 : (!simulation.logic<4>, !simulation.logic<2>, i3) -> !simulation.logic<4>
  %t9 = func.call @encode(%t8) : (!simulation.logic<4>) -> i8
  %t10 = simulation.logic.reduction xor %kx : !simulation.logic<4> -> !simulation.logic<1>
  %t11 = simulation.logic.resize %t10 signed = false : !simulation.logic<1> -> !simulation.logic<4>
  %t12 = func.call @encode(%t11) : (!simulation.logic<4>) -> i8
  %t13 = simulation.logic.reduction xnor %kx : !simulation.logic<4> -> !simulation.logic<1>
  %t14 = simulation.logic.resize %t13 signed = false : !simulation.logic<1> -> !simulation.logic<4>
  %t15 = func.call @encode(%t14) : (!simulation.logic<4>) -> i8
  %t16 = simulation.logic.binary and %kx, %x : !simulation.logic<4>
  %t17 = simulation.logic.to_bits %t16 : !simulation.logic<4> -> i4
  %t18 = arith.extui %t17 : i4 to i8
  %t19 = simulation.logic.binary or %x, %ky : !simulation.logic<4>
  %t20 = simulation.logic.to_bits %t19 : !simulation.logic<4> -> i4
  %t21 = arith.extui %t20 : i4 to i8
  %r0 = arith.extui %t2 : i8 to i64
  %s0 = arith.constant 0 : i64
  %q0 = arith.shli %r0, %s0 : i64
  %r1 = arith.extui %t5 : i8 to i64
  %s1 = arith.constant 8 : i64
  %q1 = arith.shli %r1, %s1 : i64
  %o1 = arith.ori %q0, %q1 : i64
  %r2 = arith.extui %t9 : i8 to i64
  %s2 = arith.constant 16 : i64
  %q2 = arith.shli %r2, %s2 : i64
  %o2 = arith.ori %o1, %q2 : i64
  %r3 = arith.extui %t12 : i8 to i64
  %s3 = arith.constant 24 : i64
  %q3 = arith.shli %r3, %s3 : i64
  %o3 = arith.ori %o2, %q3 : i64
  %r4 = arith.extui %t15 : i8 to i64
  %s4 = arith.constant 32 : i64
  %q4 = arith.shli %r4, %s4 : i64
  %o4 = arith.ori %o3, %q4 : i64
  %r5 = arith.extui %t18 : i8 to i64
  %s5 = arith.constant 40 : i64
  %q5 = arith.shli %r5, %s5 : i64
  %o5 = arith.ori %o4, %q5 : i64
  %r6 = arith.extui %t21 : i8 to i64
  %s6 = arith.constant 48 : i64
  %q6 = arith.shli %r6, %s6 : i64
  %o6 = arith.ori %o5, %q6 : i64
  return %o6 : i64
}

func.func @population_counts(%a: i8, %b: i8) -> i64 {
  %x = func.call @decode(%a) : (i8) -> !simulation.logic<4>
  %y = func.call @decode(%b) : (i8) -> !simulation.logic<4>
  %x1 = simulation.logic.extract %x from 0 : !simulation.logic<4> -> !simulation.logic<1>
  %y1 = simulation.logic.extract %y from 0 : !simulation.logic<4> -> !simulation.logic<1>
  %c1 = simulation.logic.extract %y from 1 : !simulation.logic<4> -> !simulation.logic<1>
  %na = arith.trunci %a : i8 to i4
  %nb = arith.trunci %b : i8 to i4
  %kx = simulation.logic.from_bits %na : i4 -> !simulation.logic<4>
  %ky = simulation.logic.from_bits %nb : i4 -> !simulation.logic<4>
  %xy = simulation.logic.concat %x, %y : (!simulation.logic<4>, !simulation.logic<4>) -> !simulation.logic<8>
  %xyand = simulation.logic.binary and %x, %y : !simulation.logic<4>
  %t0 = simulation.logic.constant 0 : i1, 0 : i1 : !simulation.logic<1>
  %t1 = simulation.logic.constant 1 : i1, 0 : i1 : !simulation.logic<1>
  %t2 = simulation.logic.constant 0 : i1, 1 : i1 : !simulation.logic<1>
  %t3 = simulation.logic.constant 1 : i1, 1 : i1 : !simulation.logic<1>
  %t4 = simulation.logic.count_bits %kx matching %t1 : (!simulation.logic<4>, !simulation.logic<1>) -> i32
  %t5 = arith.trunci %t4 : i32 to i8
  %t6 = simulation.logic.count_bits %kx matching %t0 : (!simulation.logic<4>, !simulation.logic<1>) -> i32
  %t7 = arith.trunci %t6 : i32 to i8
  %t8 = simulation.logic.count_bits %kx matching %t0, %t1 : (!simulation.logic<4>, !simulation.logic<1>, !simulation.logic<1>) -> i32
  %t9 = arith.trunci %t8 : i32 to i8
  %t10 = simulation.logic.count_bits %x matching %t1 : (!simulation.logic<4>, !simulation.logic<1>) -> i32
  %t11 = arith.trunci %t10 : i32 to i8
  %t12 = simulation.logic.count_bits %x matching %t0 : (!simulation.logic<4>, !simulation.logic<1>) -> i32
  %t13 = arith.trunci %t12 : i32 to i8
  %t14 = simulation.logic.count_bits %x matching %t0, %t1 : (!simulation.logic<4>, !simulation.logic<1>, !simulation.logic<1>) -> i32
  %t15 = arith.trunci %t14 : i32 to i8
  %t16 = simulation.logic.count_bits %x matching %t2, %t3 : (!simulation.logic<4>, !simulation.logic<1>, !simulation.logic<1>) -> i32
