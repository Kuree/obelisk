// Generated four-state differential input for canonical forms. Values
// encode four low value bits and four high unknown bits.

func.func @decode(%arg: i8) -> !simulation.logic<4> {
  %s0 = arith.constant 0 : i8
  %v0 = arith.shrui %arg, %s0 : i8
  %vb0 = arith.trunci %v0 : i8 to i1
  %u0 = arith.constant 4 : i8
  %h0 = arith.shrui %arg, %u0 : i8
  %ub0 = arith.trunci %h0 : i8 to i1
  %known0 = simulation.logic.from_bits %vb0 : i1 -> !simulation.logic<1>
  %x0 = simulation.logic.constant 0 : i1, 1 : i1 : !simulation.logic<1>
  %z0 = simulation.logic.constant 1 : i1, 1 : i1 : !simulation.logic<1>
  %unknown0 = arith.select %vb0, %z0, %x0 : !simulation.logic<1>
  %bit0 = arith.select %ub0, %unknown0, %known0 : !simulation.logic<1>
  %s1 = arith.constant 1 : i8
  %v1 = arith.shrui %arg, %s1 : i8
  %vb1 = arith.trunci %v1 : i8 to i1
  %u1 = arith.constant 5 : i8
  %h1 = arith.shrui %arg, %u1 : i8
  %ub1 = arith.trunci %h1 : i8 to i1
  %known1 = simulation.logic.from_bits %vb1 : i1 -> !simulation.logic<1>
  %x1 = simulation.logic.constant 0 : i1, 1 : i1 : !simulation.logic<1>
  %z1 = simulation.logic.constant 1 : i1, 1 : i1 : !simulation.logic<1>
  %unknown1 = arith.select %vb1, %z1, %x1 : !simulation.logic<1>
  %bit1 = arith.select %ub1, %unknown1, %known1 : !simulation.logic<1>
  %s2 = arith.constant 2 : i8
  %v2 = arith.shrui %arg, %s2 : i8
  %vb2 = arith.trunci %v2 : i8 to i1
  %u2 = arith.constant 6 : i8
  %h2 = arith.shrui %arg, %u2 : i8
  %ub2 = arith.trunci %h2 : i8 to i1
  %known2 = simulation.logic.from_bits %vb2 : i1 -> !simulation.logic<1>
  %x2 = simulation.logic.constant 0 : i1, 1 : i1 : !simulation.logic<1>
  %z2 = simulation.logic.constant 1 : i1, 1 : i1 : !simulation.logic<1>
  %unknown2 = arith.select %vb2, %z2, %x2 : !simulation.logic<1>
  %bit2 = arith.select %ub2, %unknown2, %known2 : !simulation.logic<1>
  %s3 = arith.constant 3 : i8
  %v3 = arith.shrui %arg, %s3 : i8
  %vb3 = arith.trunci %v3 : i8 to i1
  %u3 = arith.constant 7 : i8
  %h3 = arith.shrui %arg, %u3 : i8
  %ub3 = arith.trunci %h3 : i8 to i1
  %known3 = simulation.logic.from_bits %vb3 : i1 -> !simulation.logic<1>
  %x3 = simulation.logic.constant 0 : i1, 1 : i1 : !simulation.logic<1>
  %z3 = simulation.logic.constant 1 : i1, 1 : i1 : !simulation.logic<1>
  %unknown3 = arith.select %vb3, %z3, %x3 : !simulation.logic<1>
  %bit3 = arith.select %ub3, %unknown3, %known3 : !simulation.logic<1>
  %r = simulation.logic.concat %bit3, %bit2, %bit1, %bit0 : (!simulation.logic<1>, !simulation.logic<1>, !simulation.logic<1>, !simulation.logic<1>) -> !simulation.logic<4>
  return %r : !simulation.logic<4>
}

func.func @encode(%arg: !simulation.logic<4>) -> i8 {
  %zero = arith.constant 0 : i8
  %x = simulation.logic.constant 0 : i1, 1 : i1 : !simulation.logic<1>
  %z = simulation.logic.constant 1 : i1, 1 : i1 : !simulation.logic<1>
  %bit0 = simulation.logic.extract %arg from 0 : !simulation.logic<4> -> !simulation.logic<1>
  %x0 = simulation.logic.compare case_eq %bit0, %x : (!simulation.logic<1>, !simulation.logic<1>) -> i1
  %z0 = simulation.logic.compare case_eq %bit0, %z : (!simulation.logic<1>, !simulation.logic<1>) -> i1
  %one0 = simulation.logic.is_true %bit0 : !simulation.logic<1>
  %v0 = arith.ori %one0, %z0 : i1
  %u0 = arith.ori %x0, %z0 : i1
  %ve0 = arith.extui %v0 : i1 to i8
  %ue0 = arith.extui %u0 : i1 to i8
  %vs0 = arith.constant 0 : i8
  %us0 = arith.constant 4 : i8
  %vp0 = arith.shli %ve0, %vs0 : i8
  %up0 = arith.shli %ue0, %us0 : i8
  %p0 = arith.ori %vp0, %up0 : i8
  %r0 = arith.ori %zero, %p0 : i8
  %bit1 = simulation.logic.extract %arg from 1 : !simulation.logic<4> -> !simulation.logic<1>
  %x1 = simulation.logic.compare case_eq %bit1, %x : (!simulation.logic<1>, !simulation.logic<1>) -> i1
  %z1 = simulation.logic.compare case_eq %bit1, %z : (!simulation.logic<1>, !simulation.logic<1>) -> i1
  %one1 = simulation.logic.is_true %bit1 : !simulation.logic<1>
  %v1 = arith.ori %one1, %z1 : i1
  %u1 = arith.ori %x1, %z1 : i1
  %ve1 = arith.extui %v1 : i1 to i8
  %ue1 = arith.extui %u1 : i1 to i8
  %vs1 = arith.constant 1 : i8
  %us1 = arith.constant 5 : i8
  %vp1 = arith.shli %ve1, %vs1 : i8
  %up1 = arith.shli %ue1, %us1 : i8
  %p1 = arith.ori %vp1, %up1 : i8
  %r1 = arith.ori %r0, %p1 : i8
  %bit2 = simulation.logic.extract %arg from 2 : !simulation.logic<4> -> !simulation.logic<1>
  %x2 = simulation.logic.compare case_eq %bit2, %x : (!simulation.logic<1>, !simulation.logic<1>) -> i1
  %z2 = simulation.logic.compare case_eq %bit2, %z : (!simulation.logic<1>, !simulation.logic<1>) -> i1
  %one2 = simulation.logic.is_true %bit2 : !simulation.logic<1>
  %v2 = arith.ori %one2, %z2 : i1
  %u2 = arith.ori %x2, %z2 : i1
  %ve2 = arith.extui %v2 : i1 to i8
  %ue2 = arith.extui %u2 : i1 to i8
  %vs2 = arith.constant 2 : i8
  %us2 = arith.constant 6 : i8
  %vp2 = arith.shli %ve2, %vs2 : i8
  %up2 = arith.shli %ue2, %us2 : i8
  %p2 = arith.ori %vp2, %up2 : i8
  %r2 = arith.ori %r1, %p2 : i8
  %bit3 = simulation.logic.extract %arg from 3 : !simulation.logic<4> -> !simulation.logic<1>
  %x3 = simulation.logic.compare case_eq %bit3, %x : (!simulation.logic<1>, !simulation.logic<1>) -> i1
  %z3 = simulation.logic.compare case_eq %bit3, %z : (!simulation.logic<1>, !simulation.logic<1>) -> i1
  %one3 = simulation.logic.is_true %bit3 : !simulation.logic<1>
  %v3 = arith.ori %one3, %z3 : i1
  %u3 = arith.ori %x3, %z3 : i1
  %ve3 = arith.extui %v3 : i1 to i8
  %ue3 = arith.extui %u3 : i1 to i8
  %vs3 = arith.constant 3 : i8
  %us3 = arith.constant 7 : i8
  %vp3 = arith.shli %ve3, %vs3 : i8
  %up3 = arith.shli %ue3, %us3 : i8
  %p3 = arith.ori %vp3, %up3 : i8
  %r3 = arith.ori %r2, %p3 : i8
  return %r3 : i8
}

func.func @truth_conditions(%a: i8, %b: i8) -> i64 {
  %x = func.call @decode(%a) : (i8) -> !simulation.logic<4>
  %y = func.call @decode(%b) : (i8) -> !simulation.logic<4>
  %x1 = simulation.logic.extract %x from 0 : !simulation.logic<4> -> !simulation.logic<1>
  %y1 = simulation.logic.extract %y from 0 : !simulation.logic<4> -> !simulation.logic<1>
  %c1 = simulation.logic.extract %y from 1 : !simulation.logic<4> -> !simulation.logic<1>
  %na = arith.trunci %a : i8 to i4
  %nb = arith.trunci %b : i8 to i4
  %kx = simulation.logic.from_bits %na : i4 -> !simulation.logic<4>
  %ky = simulation.logic.from_bits %nb : i4 -> !simulation.logic<4>
  %xy = simulation.logic.concat %x, %y : (!simulation.logic<4>, !simulation.logic<4>) -> !simulation.logic<8>
  %xyand = simulation.logic.binary and %x, %y : !simulation.logic<4>
  %t0 = simulation.logic.logical and %x, %y : (!simulation.logic<4>, !simulation.logic<4>) -> !simulation.logic<1>
  %t1 = simulation.logic.is_true %t0 : !simulation.logic<1>
  %t2 = arith.extui %t1 : i1 to i8
  %t3 = simulation.logic.logical or %x, %y : (!simulation.logic<4>, !simulation.logic<4>) -> !simulation.logic<1>
  %t4 = simulation.logic.is_true %t3 : !simulation.logic<1>
  %t5 = arith.extui %t4 : i1 to i8
  %t6 = simulation.logic.binary or %x, %y : !simulation.logic<4>
  %t7 = simulation.logic.is_true %t6 : !simulation.logic<4>
  %t8 = arith.extui %t7 : i1 to i8
  %t9 = simulation.logic.binary and %x1, %y1 : !simulation.logic<1>
  %t10 = simulation.logic.is_true %t9 : !simulation.logic<1>
  %t11 = arith.extui %t10 : i1 to i8
  %t12 = simulation.logic.unary logical_not %x : (!simulation.logic<4>) -> !simulation.logic<1>
  %t13 = simulation.logic.is_true %t12 : !simulation.logic<1>
  %t14 = arith.extui %t13 : i1 to i8
  %t15 = simulation.logic.constant 5 : i4, 0 : i4 : !simulation.logic<4>
  %t16 = simulation.logic.compare eq %x, %t15 : (!simulation.logic<4>, !simulation.logic<4>) -> !simulation.logic<1>
  %t17 = simulation.logic.is_true %t16 : !simulation.logic<1>
  %t18 = arith.extui %t17 : i1 to i8
  %t19 = simulation.logic.constant 5 : i4, 2 : i4 : !simulation.logic<4>
  %t20 = simulation.logic.compare eq %x, %t19 : (!simulation.logic<4>, !simulation.logic<4>) -> !simulation.logic<1>
  %t21 = simulation.logic.is_true %t20 : !simulation.logic<1>
  %t22 = arith.extui %t21 : i1 to i8
  %t23 = simulation.logic.reduction and %x : !simulation.logic<4> -> !simulation.logic<1>
  %t24 = simulation.logic.is_true %t23 : !simulation.logic<1>
  %t25 = arith.extui %t24 : i1 to i8
  %r0 = arith.extui %t2 : i8 to i64
  %s0 = arith.constant 0 : i64
  %q0 = arith.shli %r0, %s0 : i64
  %r1 = arith.extui %t5 : i8 to i64
  %s1 = arith.constant 8 : i64
  %q1 = arith.shli %r1, %s1 : i64
  %o1 = arith.ori %q0, %q1 : i64
  %r2 = arith.extui %t8 : i8 to i64
  %s2 = arith.constant 16 : i64
  %q2 = arith.shli %r2, %s2 : i64
  %o2 = arith.ori %o1, %q2 : i64
  %r3 = arith.extui %t11 : i8 to i64
  %s3 = arith.constant 24 : i64
  %q3 = arith.shli %r3, %s3 : i64
  %o3 = arith.ori %o2, %q3 : i64
  %r4 = arith.extui %t14 : i8 to i64
  %s4 = arith.constant 32 : i64
  %q4 = arith.shli %r4, %s4 : i64
  %o4 = arith.ori %o3, %q4 : i64
  %r5 = arith.extui %t18 : i8 to i64
  %s5 = arith.constant 40 : i64
  %q5 = arith.shli %r5, %s5 : i64
  %o5 = arith.ori %o4, %q5 : i64
  %r6 = arith.extui %t22 : i8 to i64
  %s6 = arith.constant 48 : i64
  %q6 = arith.shli %r6, %s6 : i64
  %o6 = arith.ori %o5, %q6 : i64
  %r7 = arith.extui %t25 : i8 to i64
  %s7 = arith.constant 56 : i64
  %q7 = arith.shli %r7, %s7 : i64
  %o7 = arith.ori %o6, %q7 : i64
  return %o7 : i64
}

func.func @truth_sources(%a: i8, %b: i8) -> i64 {
  %x = func.call @decode(%a) : (i8) -> !simulation.logic<4>
  %y = func.call @decode(%b) : (i8) -> !simulation.logic<4>
  %x1 = simulation.logic.extract %x from 0 : !simulation.logic<4> -> !simulation.logic<1>
  %y1 = simulation.logic.extract %y from 0 : !simulation.logic<4> -> !simulation.logic<1>
  %c1 = simulation.logic.extract %y from 1 : !simulation.logic<4> -> !simulation.logic<1>
  %na = arith.trunci %a : i8 to i4
  %nb = arith.trunci %b : i8 to i4
  %kx = simulation.logic.from_bits %na : i4 -> !simulation.logic<4>
  %ky = simulation.logic.from_bits %nb : i4 -> !simulation.logic<4>
  %xy = simulation.logic.concat %x, %y : (!simulation.logic<4>, !simulation.logic<4>) -> !simulation.logic<8>
  %xyand = simulation.logic.binary and %x, %y : !simulation.logic<4>
  %t0 = simulation.logic.reduction nor %x : !simulation.logic<4> -> !simulation.logic<1>
  %t1 = simulation.logic.is_true %t0 : !simulation.logic<1>
  %t2 = arith.extui %t1 : i1 to i8
  %t3 = simulation.logic.reduction or %x : !simulation.logic<4> -> !simulation.logic<1>
  %t4 = simulation.logic.unary logical_not %t3 : (!simulation.logic<1>) -> !simulation.logic<1>
  %t5 = simulation.logic.is_true %t4 : !simulation.logic<1>
  %t6 = arith.extui %t5 : i1 to i8
  %t7 = simulation.logic.replicate %x times 2 : !simulation.logic<4> -> !simulation.logic<8>
  %t8 = simulation.logic.unary logical_not %t7 : (!simulation.logic<8>) -> !simulation.logic<1>
  %t9 = simulation.logic.is_true %t8 : !simulation.logic<1>
  %t10 = arith.extui %t9 : i1 to i8
  %t11 = simulation.logic.resize %x signed = true : !simulation.logic<4> -> !simulation.logic<8>
  %t12 = simulation.logic.unary logical_not %t11 : (!simulation.logic<8>) -> !simulation.logic<1>
  %t13 = simulation.logic.is_true %t12 : !simulation.logic<1>
  %t14 = arith.extui %t13 : i1 to i8
  %t15 = simulation.logic.constant 0 : i4, 0 : i4 : !simulation.logic<4>
  %t16 = simulation.logic.compare ne %x, %t15 : (!simulation.logic<4>, !simulation.logic<4>) -> !simulation.logic<1>
  %t17 = simulation.logic.is_true %t16 : !simulation.logic<1>
  %t18 = arith.extui %t17 : i1 to i8
  %t19 = simulation.logic.compare eq %x, %t15 : (!simulation.logic<4>, !simulation.logic<4>) -> !simulation.logic<1>
  %t20 = simulation.logic.is_true %t19 : !simulation.logic<1>
  %t21 = arith.extui %t20 : i1 to i8
  %t22 = simulation.logic.compare eq %kx, %ky : (!simulation.logic<4>, !simulation.logic<4>) -> !simulation.logic<1>
  %t23 = simulation.logic.is_true %t22 : !simulation.logic<1>
  %t24 = arith.extui %t23 : i1 to i8
  %t25 = simulation.logic.unary logical_not %kx : (!simulation.logic<4>) -> !simulation.logic<1>
  %t26 = simulation.logic.is_true %t25 : !simulation.logic<1>
  %t27 = arith.extui %t26 : i1 to i8
  %r0 = arith.extui %t2 : i8 to i64
  %s0 = arith.constant 0 : i64
  %q0 = arith.shli %r0, %s0 : i64
  %r1 = arith.extui %t6 : i8 to i64
  %s1 = arith.constant 8 : i64
  %q1 = arith.shli %r1, %s1 : i64
  %o1 = arith.ori %q0, %q1 : i64
  %r2 = arith.extui %t10 : i8 to i64
  %s2 = arith.constant 16 : i64
  %q2 = arith.shli %r2, %s2 : i64
  %o2 = arith.ori %o1, %q2 : i64
  %r3 = arith.extui %t14 : i8 to i64
  %s3 = arith.constant 24 : i64
  %q3 = arith.shli %r3, %s3 : i64
  %o3 = arith.ori %o2, %q3 : i64
  %r4 = arith.extui %t18 : i8 to i64
  %s4 = arith.constant 32 : i64
  %q4 = arith.shli %r4, %s4 : i64
  %o4 = arith.ori %o3, %q4 : i64
  %r5 = arith.extui %t21 : i8 to i64
  %s5 = arith.constant 40 : i64
  %q5 = arith.shli %r5, %s5 : i64
  %o5 = arith.ori %o4, %q5 : i64
  %r6 = arith.extui %t24 : i8 to i64
  %s6 = arith.constant 48 : i64
  %q6 = arith.shli %r6, %s6 : i64
  %o6 = arith.ori %o5, %q6 : i64
  %r7 = arith.extui %t27 : i8 to i64
  %s7 = arith.constant 56 : i64
  %q7 = arith.shli %r7, %s7 : i64
  %o7 = arith.ori %o6, %q7 : i64
  return %o7 : i64
}

func.func @negations(%a: i8, %b: i8) -> i64 {
  %x = func.call @decode(%a) : (i8) -> !simulation.logic<4>
  %y = func.call @decode(%b) : (i8) -> !simulation.logic<4>
  %x1 = simulation.logic.extract %x from 0 : !simulation.logic<4> -> !simulation.logic<1>
  %y1 = simulation.logic.extract %y from 0 : !simulation.logic<4> -> !simulation.logic<1>
  %c1 = simulation.logic.extract %y from 1 : !simulation.logic<4> -> !simulation.logic<1>
  %na = arith.trunci %a : i8 to i4
  %nb = arith.trunci %b : i8 to i4
  %kx = simulation.logic.from_bits %na : i4 -> !simulation.logic<4>
  %ky = simulation.logic.from_bits %nb : i4 -> !simulation.logic<4>
  %xy = simulation.logic.concat %x, %y : (!simulation.logic<4>, !simulation.logic<4>) -> !simulation.logic<8>
  %xyand = simulation.logic.binary and %x, %y : !simulation.logic<4>
  %t0 = simulation.logic.constant 0 : i4, 0 : i4 : !simulation.logic<4>
  %t1 = simulation.logic.compare eq %x, %t0 : (!simulation.logic<4>, !simulation.logic<4>) -> !simulation.logic<1>
  %t2 = simulation.logic.resize %t1 signed = false : !simulation.logic<1> -> !simulation.logic<4>
  %t3 = func.call @encode(%t2) : (!simulation.logic<4>) -> i8
  %t4 = simulation.logic.compare ne %x, %t0 : (!simulation.logic<4>, !simulation.logic<4>) -> !simulation.logic<1>
  %t5 = simulation.logic.resize %t4 signed = false : !simulation.logic<1> -> !simulation.logic<4>
  %t6 = func.call @encode(%t5) : (!simulation.logic<4>) -> i8
  %t7 = simulation.logic.compare ult %x, %y : (!simulation.logic<4>, !simulation.logic<4>) -> !simulation.logic<1>
  %t8 = simulation.logic.unary logical_not %t7 : (!simulation.logic<1>) -> !simulation.logic<1>
  %t9 = simulation.logic.resize %t8 signed = false : !simulation.logic<1> -> !simulation.logic<4>
  %t10 = func.call @encode(%t9) : (!simulation.logic<4>) -> i8
  %t11 = simulation.logic.compare sge %x, %y : (!simulation.logic<4>, !simulation.logic<4>) -> !simulation.logic<1>
  %t12 = simulation.logic.unary logical_not %t11 : (!simulation.logic<1>) -> !simulation.logic<1>
  %t13 = simulation.logic.resize %t12 signed = false : !simulation.logic<1> -> !simulation.logic<4>
  %t14 = func.call @encode(%t13) : (!simulation.logic<4>) -> i8
  %t15 = simulation.logic.compare wild_eq %x, %y : (!simulation.logic<4>, !simulation.logic<4>) -> !simulation.logic<1>
  %t16 = simulation.logic.unary logical_not %t15 : (!simulation.logic<1>) -> !simulation.logic<1>
  %t17 = simulation.logic.resize %t16 signed = false : !simulation.logic<1> -> !simulation.logic<4>
  %t18 = func.call @encode(%t17) : (!simulation.logic<4>) -> i8
  %t19 = simulation.logic.compare eq %x, %y : (!simulation.logic<4>, !simulation.logic<4>) -> !simulation.logic<1>
  %t20 = simulation.logic.unary logical_not %t19 : (!simulation.logic<1>) -> !simulation.logic<1>
  %t21 = simulation.logic.resize %t20 signed = false : !simulation.logic<1> -> !simulation.logic<4>
  %t22 = func.call @encode(%t21) : (!simulation.logic<4>) -> i8
  %t23 = simulation.logic.unary logical_not %x : (!simulation.logic<4>) -> !simulation.logic<1>
  %t24 = simulation.logic.unary logical_not %t23 : (!simulation.logic<1>) -> !simulation.logic<1>
  %t25 = simulation.logic.resize %t24 signed = false : !simulation.logic<1> -> !simulation.logic<4>
  %t26 = func.call @encode(%t25) : (!simulation.logic<4>) -> i8
  %t27 = simulation.logic.reduction and %x : !simulation.logic<4> -> !simulation.logic<1>
  %t28 = simulation.logic.unary logical_not %t27 : (!simulation.logic<1>) -> !simulation.logic<1>
  %t29 = simulation.logic.resize %t28 signed = false : !simulation.logic<1> -> !simulation.logic<4>
  %t30 = func.call @encode(%t29) : (!simulation.logic<4>) -> i8
  %r0 = arith.extui %t3 : i8 to i64
  %s0 = arith.constant 0 : i64
  %q0 = arith.shli %r0, %s0 : i64
  %r1 = arith.extui %t6 : i8 to i64
  %s1 = arith.constant 8 : i64
  %q1 = arith.shli %r1, %s1 : i64
  %o1 = arith.ori %q0, %q1 : i64
  %r2 = arith.extui %t10 : i8 to i64
  %s2 = arith.constant 16 : i64
  %q2 = arith.shli %r2, %s2 : i64
  %o2 = arith.ori %o1, %q2 : i64
  %r3 = arith.extui %t14 : i8 to i64
  %s3 = arith.constant 24 : i64
  %q3 = arith.shli %r3, %s3 : i64
  %o3 = arith.ori %o2, %q3 : i64
  %r4 = arith.extui %t18 : i8 to i64
  %s4 = arith.constant 32 : i64
  %q4 = arith.shli %r4, %s4 : i64
  %o4 = arith.ori %o3, %q4 : i64
  %r5 = arith.extui %t22 : i8 to i64
  %s5 = arith.constant 40 : i64
  %q5 = arith.shli %r5, %s5 : i64
  %o5 = arith.ori %o4, %q5 : i64
  %r6 = arith.extui %t26 : i8 to i64
  %s6 = arith.constant 48 : i64
  %q6 = arith.shli %r6, %s6 : i64
  %o6 = arith.ori %o5, %q6 : i64
  %r7 = arith.extui %t30 : i8 to i64
