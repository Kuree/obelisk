  %t8 = func.call @encode(%t7) : (!simulation.logic<4>) -> i8
  %t9 = simulation.logic.constant 3 : i4, 0 : i4 : !simulation.logic<4>
  %t10 = simulation.logic.constant 15 : i4, 0 : i4 : !simulation.logic<4>
  %t11 = simulation.logic.binary udiv %kx, %t9 : !simulation.logic<4>
  %t12 = func.call @encode(%t11) : (!simulation.logic<4>) -> i8
  %t13 = simulation.logic.binary umod %kx, %t9 : !simulation.logic<4>
  %t14 = func.call @encode(%t13) : (!simulation.logic<4>) -> i8
  %t15 = simulation.logic.binary sdiv %kx, %t9 : !simulation.logic<4>
  %t16 = func.call @encode(%t15) : (!simulation.logic<4>) -> i8
  %t17 = simulation.logic.binary smod %kx, %t9 : !simulation.logic<4>
  %t18 = func.call @encode(%t17) : (!simulation.logic<4>) -> i8
