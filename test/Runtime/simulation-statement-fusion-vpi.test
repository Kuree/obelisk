// REQUIRES: native-elf
// The harness interposes runtime calls with the ELF linker's --wrap option.
// RUN: %llvm_dist/bin/clang -I%S/../../runtime/include -I%resource_dir/include -c %S/Inputs/statement-fusion-vpi.c -o %t.helper.o
// RUN: talos-opt %S/Inputs/statement-fusion-vpi.mlir --pass-pipeline='builtin.module(simulation.design(talos-sim-build-compute-graph{vpi=full},schedule-plan-combinational-statements,talos-sim-materialize-compute-fusion,simulation.func(talos-sim-thread-suspension),talos-sim-build-compute-graph{vpi=full},talos-sim-verify-compute-graph,talos-sim-materialize-graph-regions,talos-sim-materialize-compute-fusion,talos-sim-specialize-static-state-nba,talos-sim-plan-static-superstep),encode-talos-sim-to-bytecode{vpi=full prune-native=true},convert-talos-sim-processes-to-llvm-coroutines)' | talos-translate --mlir-to-llvmir | %llvm_dist/bin/opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O0>' | %llc -filetype=obj -relocation-model=pic -o %t.o
// RUN: %target_cxx %t.o %t.helper.o -Wl,--wrap=talos_rt_v1_scheduler_run -Wl,--wrap=talos_rt_v1_display %runtime_link_flags -o %t.exe
// RUN: %t.exe | FileCheck %s

// Acyclic statement dependencies do not make internal VPI deposits
// safe for unconditional whole-body replay. Preserve exact owner activation.

// CHECK: step 0 input=07 internal=08 output=08
// CHECK-NEXT: step 1 input=09 internal=0a output=0a
// CHECK-NEXT: step 2 input=09 internal=40 output=40
// CHECK-NEXT: step 3 input=09 internal=40 output=40
// CHECK-NEXT: step 4 input=09 internal=07 output=07
// CHECK-NEXT: step 5 input=0b internal=07 output=07
// CHECK-NEXT: step 6 input=0b internal=07 output=07
// CHECK-NEXT: step 7 input=0c internal=0d output=0d
// CHECK-NEXT: step 8 input=0c internal=xx output=xx
// CHECK-NEXT: step 9 input=0c internal=zz output=zz
// CHECK-NEXT: step 10 input=ff internal=00 output=00
// CHECK-NEXT: step 11 input=ff internal=00 output=63
// CHECK-NEXT: step 12 input=00 internal=01 output=01
