// Runtime semantics for ../Conversion/simulation-gc-uvm-*.mlir and
// ../Conversion/simulation-gc-polled-roots.mlir. Each
// UVM-shaped class testbench runs with a GC threshold small enough that the
// heap collects many times. Every collection must keep each strongly
// reachable object (IEEE 1800-2023 8.29): handles in class fields, static
// members, queues, mailboxes, forked workers and suspended process frames.
// With a periodic clock, collections move to the designated point once per
// cycle; without one, allocation keeps collecting. Under polled collection
// (obelisk-sim-insert-gc-polls) allocation never collects: activations root
// managed values only at polls and calls reaching one, and the heap reclaims
// at polls, between activations, and at designated points. A threshold of one
// byte reclaims at every such opportunity.

// RUN: obelisk-opt %S/../Conversion/simulation-gc-uvm-sequence.mlir --pass-pipeline='builtin.module(simulation.design(simulation.func(obelisk-sim-thread-suspension)),encode-obelisk-sim-to-bytecode{vpi=off prune-native=true},simulation.design(obelisk-sim-optimize-native-regions),simulation.design(obelisk-sim-plan-native-partitions),convert-obelisk-sim-processes-to-llvm-coroutines,materialize-runtime-byte-globals)' | mlir-translate --mlir-to-llvmir | %llvm_dist/bin/opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' | %llc -filetype=obj -relocation-model=pic -o %t.sequence.o
// RUN: %llvm_dist/bin/clang++ %t.sequence.o %native_support/libobelisk_rt.a %native_support/libc++.a %native_support/libc++abi.a %native_support/libunwind.a -nostdlib++ -lpthread -ldl -o %t.sequence.exe
// RUN: env OBELISK_RT_GC_THRESHOLD=256 OBELISK_RT_GC_DIAGNOSTICS=1 %t.sequence.exe 2>&1 | FileCheck %s --check-prefix=SEQUENCE
// RUN: %t.sequence.exe 2>&1 | FileCheck %s --check-prefix=SEQUENCE-RESULT

// RUN: obelisk-opt %S/../Conversion/simulation-gc-uvm-mailbox.mlir --pass-pipeline='builtin.module(simulation.design(obelisk-sim-plan-native-partitions),convert-obelisk-sim-processes-to-llvm-coroutines,materialize-runtime-byte-globals)' | mlir-translate --mlir-to-llvmir | %llvm_dist/bin/opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' | %llc -filetype=obj -relocation-model=pic -o %t.mailbox.o
// RUN: %llvm_dist/bin/clang++ %t.mailbox.o %native_support/libobelisk_rt.a %native_support/libc++.a %native_support/libc++abi.a %native_support/libunwind.a -nostdlib++ -lpthread -ldl -o %t.mailbox.exe
// RUN: env OBELISK_RT_GC_THRESHOLD=256 OBELISK_RT_GC_DIAGNOSTICS=1 %t.mailbox.exe 2>&1 | FileCheck %s --check-prefix=MAILBOX

// RUN: obelisk-opt %S/../Conversion/simulation-gc-uvm-sequence.mlir --pass-pipeline='builtin.module(obelisk-sim-insert-gc-polls,simulation.design(simulation.func(obelisk-sim-thread-suspension)),encode-obelisk-sim-to-bytecode{vpi=off prune-native=true},simulation.design(obelisk-sim-optimize-native-regions),simulation.design(obelisk-sim-plan-native-partitions),convert-obelisk-sim-processes-to-llvm-coroutines,materialize-runtime-byte-globals)' | mlir-translate --mlir-to-llvmir | %llvm_dist/bin/opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' | %llc -filetype=obj -relocation-model=pic -o %t.polled-sequence.o
// RUN: %llvm_dist/bin/clang++ %t.polled-sequence.o %native_support/libobelisk_rt.a %native_support/libc++.a %native_support/libc++abi.a %native_support/libunwind.a -nostdlib++ -lpthread -ldl -o %t.polled-sequence.exe
// RUN: env OBELISK_RT_GC_THRESHOLD=256 OBELISK_RT_GC_DIAGNOSTICS=1 %t.polled-sequence.exe 2>&1 | FileCheck %s --check-prefix=POLLED-SEQUENCE
// RUN: env OBELISK_RT_GC_THRESHOLD=1 OBELISK_RT_GC_DIAGNOSTICS=1 %t.polled-sequence.exe 2>&1 | FileCheck %s --check-prefix=POLLED-STRESS-SEQUENCE

// RUN: obelisk-opt %S/../Conversion/simulation-gc-uvm-mailbox.mlir --pass-pipeline='builtin.module(obelisk-sim-insert-gc-polls,simulation.design(obelisk-sim-plan-native-partitions),convert-obelisk-sim-processes-to-llvm-coroutines,materialize-runtime-byte-globals)' | mlir-translate --mlir-to-llvmir | %llvm_dist/bin/opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' | %llc -filetype=obj -relocation-model=pic -o %t.polled-mailbox.o
// RUN: %llvm_dist/bin/clang++ %t.polled-mailbox.o %native_support/libobelisk_rt.a %native_support/libc++.a %native_support/libc++abi.a %native_support/libunwind.a -nostdlib++ -lpthread -ldl -o %t.polled-mailbox.exe
// RUN: env OBELISK_RT_GC_THRESHOLD=1 OBELISK_RT_GC_DIAGNOSTICS=1 %t.polled-mailbox.exe 2>&1 | FileCheck %s --check-prefix=POLLED-MAILBOX

// RUN: obelisk-opt %S/../Conversion/simulation-gc-polled-roots.mlir --pass-pipeline='builtin.module(obelisk-sim-insert-gc-polls,simulation.design(simulation.func(obelisk-sim-thread-process-cfg)),encode-obelisk-sim-to-bytecode{vpi=off prune-native=true},simulation.design(obelisk-sim-optimize-native-regions),simulation.design(obelisk-sim-plan-native-partitions),convert-obelisk-sim-processes-to-llvm-coroutines,materialize-runtime-byte-globals)' | mlir-translate --mlir-to-llvmir | %llvm_dist/bin/opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' | %llc -filetype=obj -relocation-model=pic -o %t.roots.o
// RUN: %llvm_dist/bin/clang++ %t.roots.o %native_support/libobelisk_rt.a %native_support/libc++.a %native_support/libc++abi.a %native_support/libunwind.a -nostdlib++ -lpthread -ldl -o %t.roots.exe
// RUN: env OBELISK_RT_GC_THRESHOLD=1 OBELISK_RT_GC_DIAGNOSTICS=1 %t.roots.exe 2>&1 | FileCheck %s --check-prefix=ROOTS

// Twenty transactions of data 3*id; the scoreboard keeps the last four.
// SEQUENCE-RESULT: {{^}}total=570 kept=4 last=19{{$}}
// SEQUENCE: {{^}}total=570 kept=4 last=19{{$}}
// The periodic loop designates collections, and the steady state reclaims
// at its designated point rather than at an allocation.
// SEQUENCE: obelisk-gc-diagnostics collections={{[1-9][0-9]*}} designated={{[1-9][0-9]*}} {{.*}} polled=0
// POLLED-SEQUENCE: {{^}}total=570 kept=4 last=19{{$}}
// POLLED-SEQUENCE: obelisk-gc-diagnostics collections={{[1-9][0-9]*}} designated={{[1-9][0-9]*}} {{.*}} polled=1
// POLLED-STRESS-SEQUENCE: {{^}}total=570 kept=4 last=19{{$}}
// POLLED-STRESS-SEQUENCE: obelisk-gc-diagnostics collections={{[1-9][0-9]*}} {{.*}} polled=1

// Sixteen packets through the mailbox; every forked worker reads its own
// captured handle after a clock wait, and the static registry still reaches
// the whole linked history.
// MAILBOX: {{^}}checksum=576 history=120 depth=16 last=15{{$}}
// MAILBOX: obelisk-gc-diagnostics collections={{[1-9][0-9]*}} designated=0 {{.*}} polled=0
// POLLED-MAILBOX: {{^}}checksum=576 history=120 depth=16 last=15{{$}}
// POLLED-MAILBOX: obelisk-gc-diagnostics collections={{[1-9][0-9]*}} designated=0 {{.*}} polled=1

// Handles held only in the initial block's registers survive collections
// inside every callee: loops, recursion, string churn and a virtual call.
// ROOTS: {{^}}keep=42 len=100 s=499500 r=1275 w=33 label=label42 t=40{{$}}
// ROOTS: obelisk-gc-diagnostics collections={{[1-9][0-9]*}} designated=0 {{.*}} polled=1
