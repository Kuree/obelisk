// RUN: obelisk-opt %S/../Conversion/simulation-native-packed-window.mlir --obelisk-sim-build-compute-graph='vpi=off' --obelisk-sim-specialize-static-state-nba --convert-obelisk-sim-processes-to-llvm-coroutines -o %t.mlir
// RUN: sed -e 's/llvm.mlir.global internal @__obelisk_state_value(/llvm.mlir.global @__obelisk_state_value(/' -e 's/llvm.mlir.global internal @__obelisk_state_unknown(/llvm.mlir.global @__obelisk_state_unknown(/' -e 's/llvm.func @main(/llvm.func @model_main(/' %t.mlir > %t.exposed.mlir
// RUN: mlir-translate --mlir-to-llvmir %t.exposed.mlir | opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O0>' -S -o %t.ll
// RUN: %llvm_dist/bin/clang++ -O0 %t.ll %S/Inputs/check-packed-window.cpp %native_support/libobelisk_rt.a %native_support/libc++.a %native_support/libc++abi.a %native_support/libunwind.a -nostdlib++ -lpthread -ldl -o %t.exe
// RUN: %t.exe | FileCheck %s
// RUN: mlir-translate --mlir-to-llvmir %t.exposed.mlir | opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' -S -o %t.ll
// RUN: %llvm_dist/bin/clang++ -O3 %t.ll %S/Inputs/check-packed-window.cpp %native_support/libobelisk_rt.a %native_support/libc++.a %native_support/libc++abi.a %native_support/libunwind.a -nostdlib++ -lpthread -ldl -o %t.exe
// RUN: %t.exe | FileCheck %s
// CHECK: packed window guards preserved
