// RUN: %python %S/Inputs/add-ranked-private-slot.py %S/Inputs/ranked-ready-order.mlir > %t.input.mlir
// A private slot must not give a boundary actor unknown shared-memory edges.
// Compare eval, generic, and bytecode execution at O0/O3.
// RUN: sed 's/schedule.native_scheduler = 3/schedule.native_scheduler = 3/' %t.input.mlir > %t.eval.mlir
// RUN: obelisk-opt %t.eval.mlir --pass-pipeline='builtin.module(simulation.design(simulation.func(obelisk-sim-thread-suspension),obelisk-sim-build-compute-graph,obelisk-sim-verify-compute-graph,obelisk-sim-materialize-graph-regions,obelisk-sim-materialize-compute-fusion,obelisk-sim-specialize-static-state-nba,obelisk-sim-plan-static-superstep),encode-obelisk-sim-to-bytecode{vpi=off prune-native=true},convert-obelisk-sim-processes-to-llvm-coroutines)' | mlir-translate --mlir-to-llvmir > %t.eval.ll
// RUN: %llvm_dist/bin/opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O0>' %t.eval.ll | %llc -filetype=obj -relocation-model=pic -o %t.eval.o0.o
// RUN: %llvm_dist/bin/clang++ %t.eval.o0.o %native_support/libobelisk_rt.a %native_support/libc++.a %native_support/libc++abi.a %native_support/libunwind.a -nostdlib++ -lpthread -ldl -o %t.eval.o0.exe
// RUN: %t.eval.o0.exe | FileCheck %s
// RUN: %llvm_dist/bin/opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' %t.eval.ll | %llc -filetype=obj -relocation-model=pic -o %t.eval.o3.o
// RUN: %llvm_dist/bin/clang++ %t.eval.o3.o %native_support/libobelisk_rt.a %native_support/libc++.a %native_support/libc++abi.a %native_support/libunwind.a -nostdlib++ -lpthread -ldl -o %t.eval.o3.exe
// RUN: %t.eval.o3.exe | FileCheck %s
// RUN: sed 's/schedule.native_scheduler = 3/schedule.native_scheduler = 1/' %t.input.mlir > %t.generic.mlir
// RUN: obelisk-opt %t.generic.mlir --pass-pipeline='builtin.module(simulation.design(simulation.func(obelisk-sim-thread-suspension),obelisk-sim-build-compute-graph,obelisk-sim-verify-compute-graph,obelisk-sim-materialize-graph-regions,obelisk-sim-materialize-compute-fusion,obelisk-sim-specialize-static-state-nba,obelisk-sim-plan-static-superstep),encode-obelisk-sim-to-bytecode{vpi=off},convert-obelisk-sim-processes-to-llvm-coroutines)' | mlir-translate --mlir-to-llvmir > %t.generic.ll
// RUN: %llvm_dist/bin/opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O0>' %t.generic.ll | %llc -filetype=obj -relocation-model=pic -o %t.generic.o0.o
