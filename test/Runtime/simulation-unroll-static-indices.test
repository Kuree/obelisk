// Execute the same source MLIR with compact and expanded loop policies.

// RUN: obelisk-opt %S/../Dialect/Simulation/Transforms/simulation-unroll-static-indices.mlir --pass-pipeline='builtin.module(simulation.design(simulation.func(obelisk-sim-unroll-bounded-loops{maximum-loop-size=0},canonicalize,cse),obelisk-sim-build-compute-graph,obelisk-sim-verify-compute-graph),convert-obelisk-sim-processes-to-llvm-coroutines)' -o %t.0.mlir
// RUN: mlir-translate --mlir-to-llvmir %t.0.mlir | opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O0>' | %llc -filetype=obj -relocation-model=pic -o %t.0.0.o
// RUN: %llvm_dist/bin/clang++ %t.0.0.o %native_support/libobelisk_rt.a %native_support/libc++.a %native_support/libc++abi.a %native_support/libunwind.a -nostdlib++ -lpthread -ldl -o %t.exe
// RUN: %t.exe | FileCheck %s
// RUN: mlir-translate --mlir-to-llvmir %t.0.mlir | opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' | %llc -filetype=obj -relocation-model=pic -o %t.0.3.o
// RUN: %llvm_dist/bin/clang++ %t.0.3.o %native_support/libobelisk_rt.a %native_support/libc++.a %native_support/libc++abi.a %native_support/libunwind.a -nostdlib++ -lpthread -ldl -o %t.exe
