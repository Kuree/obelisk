# RUN: obelisk -fno-lto -O3 --vpi=off \
# RUN:   %S/../Driver/native-finish-in-final.sv -o %t.native
# RUN: %llvm_dist/bin/llvm-nm %t.native \
# RUN:   | FileCheck %s --check-prefix=NO-DPI --allow-empty
# RUN: obelisk -fno-lto -O3 --vpi=off --execution-tier=bytecode \
# RUN:   %S/../Driver/native-finish-in-final.sv -o %t.bytecode
# RUN: %llvm_dist/bin/llvm-nm %t.bytecode \
# RUN:   | FileCheck %s --check-prefix=NO-DPI --allow-empty
# RUN: obelisk -O3 --vpi=off \
# RUN:   %S/../Driver/native-finish-in-final.sv -o %t.lto
# RUN: %llvm_dist/bin/llvm-nm %t.lto \
# RUN:   | FileCheck %s --check-prefix=NO-DPI --allow-empty

# DPI is a cold, link-time feature. Ordinary native, full-LTO, and
# whole-design-bytecode executables retain neither the DPI marshallers nor the
# standardized sv* API.
# NO-DPI-NOT: obelisk_rt_v1_dpi_
# NO-DPI-NOT: svAckDisabledState
# NO-DPI-NOT: svGetBitselBit
# NO-DPI-NOT: svGetScope
# NO-DPI-NOT: svIsDisabledState
