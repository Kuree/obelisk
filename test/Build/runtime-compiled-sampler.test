# REQUIRES: compiled-sampler
# RUN: %llvm_dist/bin/llvm-nm %native_support/libobelisk_rt.a \
# RUN:   | FileCheck %s --check-prefix=STATIC --implicit-check-not=Z3_
# RUN: %llvm_dist/bin/llvm-nm %native_support/libobelisk_rt_lto.a \
# RUN:   | FileCheck %s --check-prefix=STATIC --implicit-check-not=Z3_
# RUN: %llvm_dist/bin/llvm-ar t %native_support/libobelisk_rt.a \
# RUN:   | FileCheck %s --check-prefix=MEMBERS --implicit-check-not=libz3.a

# Target archives contain the simple sampler and no defined or unresolved Z3
# entry points. Compiler Z3 is solely responsible for generating Boolean plans.
# STATIC-DAG: T {{_?}}obelisk_rt_v1_random_solve_modes_state{{$}}
# MEMBERS: RandSamplePlan.{{o|obj}}
