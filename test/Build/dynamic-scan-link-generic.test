# RUN: talos -O3 --vpi=off --native-scheduler=generic %S/../Driver/scan-dynamic-pay-for-play.sv -o %t.exe
# RUN: %llvm_dist/bin/llvm-nm --defined-only %t.exe > %t.symbols
# RUN: FileCheck %s --check-prefix=SYMBOLS --allow-empty < %t.symbols
# Mach-O dispatchers define weak fallbacks under the HOOKS names; the feature
# symbols show that no strong definition replaced them.
# RUN: %if !native-macho %{ FileCheck %s --check-prefix=HOOKS --allow-empty < %t.symbols %}

# SYMBOLS-NOT: {{ [TtW] .*}}talos_rt_v1_dynamic_scan_link_anchor
# HOOKS-NOT:   {{ [TtW] .*}}invokeDynamicScanIntrinsic
# SYMBOLS-NOT: {{ [TtW] .*}}talos_rt_dynamic_scan_plan
# SYMBOLS-NOT: {{ [TtW] .*}}talos_rt_v1_scan_dynamic_validate
# SYMBOLS-NOT: {{ [TtW] .*}}talos_rt_v1_string_scan_dynamic
# SYMBOLS-NOT: {{ [TtW] .*}}talos_rt_v1_file_scan_dynamic
# SYMBOLS-NOT: {{ [TtW] .*}}talos_rt_v1_container_bitstream_link_anchor
# HOOKS-NOT:   {{ [TtW] .*}}invokeContainerBitstreamIntrinsic
# SYMBOLS-NOT: {{ [TtW] .*}}talos_rt_v1_container_export_bitstream
# SYMBOLS-NOT: {{ [TtW] .*}}talos_rt_v1_aggregate_export_bitstream
# SYMBOLS-NOT: {{ [TtW] .*}}talos_rt_v1_recursive_export_bitstream
# SYMBOLS-NOT: {{ [TtW] .*}}talos_rt_v1_recursive_bitstream_link_anchor
# HOOKS-NOT:   {{ [TtW] .*}}talos_rt_expand_recursive_watch_group
# SYMBOLS-NOT: {{ [TtW] .*}}talos_rt_managed_allocate_without_safepoint
# SYMBOLS-NOT: {{ [TtW] .*}}talos_rt_managed_object_acquire
# SYMBOLS-NOT: {{ [TtW] .*}}talos_rt_managed_object_release
# SYMBOLS-NOT: {{ [TtW] .*}}talos_rt_v1_class_bitstream_link_anchor
# SYMBOLS-NOT: {{ [TtW] .*}}talos_rt_v1_class_bitstream_bytecode_link_anchor
# SYMBOLS-NOT: {{ [TtW] .*}}talos_rt_v1_class_bitstream_finalize
# SYMBOLS-NOT: {{ [TtW] .*}}talos_rt_v2_recursive_export_bitstream
# SYMBOLS-NOT: {{ [TtW] .*}}talos_rt_class_bitstream_export_bytecode
# HOOKS-NOT:   {{ [TtW] .*}}talos_rt_expand_class_watch_group
# SYMBOLS-NOT: {{ [TtW] .*}}talos_rt_managed_watch_range
# HOOKS-NOT:   {{ [TtW] .*}}talos_rt_validate_dpi_exports
# SYMBOLS-NOT: {{ [TtW] .*}}talos_rt_execute_dpi_export_bytecode
# SYMBOLS-NOT: {{ [TtW] .*}}talos_rt_v1_export_call
# SYMBOLS-NOT: {{ [TtW] .*}}talos_rt_v1_export_string
# SYMBOLS-NOT: {{ [TtW] .*}}talos_rt_v1_dpi_export_unpack_vector
# SYMBOLS-NOT: {{ [TtW] .*}}talos_rt_v1_dpi_export_pack_vector
# SYMBOLS-NOT: {{ [TtW] .*}}talos_rt_v1_dpi_export_bytecode_link_anchor
