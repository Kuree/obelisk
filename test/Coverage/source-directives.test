# RUN: %split-file %s %t
# RUN: talos -O0 --coverage=line -I%t %t/top.sv -o %t/sim
# RUN: %t/sim --coverage-output=%t/coverage.obcov
# RUN: talos-cov report --format=text %t/coverage.obcov | \
# RUN:   FileCheck %s --check-prefix=REPORT
# RUN: talos-cov report --format=lcov %t/coverage.obcov -o %t/coverage.lcov
# RUN: FileCheck %s --check-prefix=CONTROL < %t/coverage.lcov
# RUN: not talos --coverage=toggle -emit-sim %t/unbalanced.sv \
# RUN:   -o %t/unbalanced.mlir 2>&1 | FileCheck %s --check-prefix=UNBALANCED
# RUN: not talos -O0 --coverage=line %t/unknown.sv \
# RUN:   -o %t/unknown 2>&1 | FileCheck %s --check-prefix=UNKNOWN

# REPORT: line:
# REPORT-DAG: outer generated region
# REPORT-DAG: outer generated region
# REPORT-DAG: nested generated region
# REPORT-DAG: macro definition region
# REPORT-DAG: macro expansion region
# REPORT-DAG: nested control body

# CONTROL: DA:13,1
# CONTROL-NOT: DA:15,

# UNBALANCED: unbalanced coverage 'off' directive
# UNKNOWN: metrics must be unique line, toggle, functional, assertion, or fsm names

#--- defs.svh
// talos coverage off line reason="macro definition region"
`define FROM_DISABLED_DEFINITION value = value + 1;
// talos coverage on line

`define FROM_ENABLED_DEFINITION value = value + 1;

#--- top.sv
`include "defs.svh"
module top;
  integer value;
  initial begin
    // talos coverage off line reason="outer generated region"
    value = 1;
    // talos coverage off line reason="nested generated region"
    value = 2;
    // talos coverage on line
    value = 3;
    // talos coverage on line
    value = 4;
    if (value) begin
      // talos coverage off line reason="nested control body"
      value = 5;
      // talos coverage on line
    end
    `FROM_DISABLED_DEFINITION
    // talos coverage off line reason="macro expansion region"
    `FROM_ENABLED_DEFINITION
    // talos coverage on line
    $finish;
  end
endmodule

#--- unbalanced.sv
module unbalanced;
  // No executable line candidates: directive validation is source-level.
endmodule
// talos coverage off line

#--- unknown.sv
module unknown;
  integer value;
  initial begin
    // talos coverage off branch
    value = 1;
    // talos coverage on branch
  end
endmodule
