# RUN: %coverage-fixture %t.obcov 21 'line SF:injected.sv' 1
# RUN: talos-cov report --format=lcov %t.obcov | FileCheck %s --implicit-check-not=SF:injected.sv

# A test name cannot start another LCOV record: characters outside the record
# grammar are replaced, so the name stays inside its TN: line and the report
# has exactly one source record.
# CHECK: TN:line_SF_injected_sv
# CHECK-NEXT: SF:dut.sv
# CHECK-NOT: SF:
