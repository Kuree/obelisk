# RUN: %split-file %s %t
# RUN: obelisk -fno-lto -O0 --coverage=line \
# RUN:   --coverage-config=%t/exclude.json %t/top.sv -o %t/exclude
# RUN: %t/exclude --coverage-output=%t/exclude.obcov
# RUN: obelisk-cov report --format=text %t/exclude.obcov | \
# RUN:   FileCheck %s --check-prefix=EXCLUDE
# RUN: obelisk -fno-lto -O0 --coverage=line \
# RUN:   --coverage-config=%t/include.json %t/top.sv -o %t/include
# RUN: %t/include --coverage-output=%t/include.obcov
# RUN: obelisk-cov report --format=text %t/include.obcov | \
# RUN:   FileCheck %s --check-prefix=INCLUDE

# EXCLUDE: line: 0.00% (0/0), partial 0
# EXCLUDE-COUNT-2: selected exclusion
# EXCLUDE-NOT: wrong hierarchy
# INCLUDE: line: 0.00% (0/0), partial 0
# INCLUDE-COUNT-2: not selected by coverage include rules

#--- top.sv
module top;
  integer value;
  initial begin
    value = 1;
    $finish;
  end
endmodule

#--- exclude.json
{
  "include": [
    {"metrics": ["line"], "file": "**/top.?v", "hierarchy": "t?p"},
    {"metrics": ["toggle"], "hierarchy": "does.not.match"}
  ],
  "exclude": [
    {
      "metrics": ["line"],
      "file": "**/top.sv",
      "hierarchy": "wrong.scope",
      "reason": "wrong hierarchy"
    },
    {
      "metrics": ["line"],
      "file": "**/top.sv",
      "hierarchy": "top",
      "reason": "selected exclusion"
    }
  ]
}

#--- include.json
{
  "include": [
    {"metrics": ["line"], "hierarchy": "other.**"}
  ]
}
