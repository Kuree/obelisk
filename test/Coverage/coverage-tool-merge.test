# RUN: %coverage-fixture %t.a.obcov 1 alpha 1
# RUN: %coverage-fixture %t.b.obcov 2 beta 0
# RUN: not obelisk-cov report --test=beta --fail-under line=1 %t.a.obcov %t.b.obcov 2>&1 | FileCheck %s --check-prefix=BAD-THRESHOLD
# RUN: not obelisk-cov merge -o %t.duplicate.obcov %t.a.obcov %t.a.obcov 2>&1 | FileCheck %s --check-prefix=DUPLICATE
# RUN: obelisk-cov merge --discard-test-detail -o %t.aggregate.obcov %t.a.obcov %t.b.obcov
# RUN: obelisk-cov inspect %t.aggregate.obcov | FileCheck %s --check-prefix=AGGREGATE
# RUN: obelisk-cov merge --discard-test-detail -o %t.single.obcov %t.a.obcov
# RUN: obelisk-cov report --format=json %t.single.obcov | FileCheck %s --check-prefix=SINGLE

# A threshold that the selected test misses fails the report and says so. The
# same run cannot be merged twice. Merging with --discard-test-detail folds
# any number of runs, including one, into a single anonymous aggregate run
# with no seed, time or tags, which is the only source of its instance group.

# BAD-THRESHOLD: line: 0.00% (0/1), partial 0 [FAIL >= 1.00%]
# DUPLICATE: duplicate run UUID
# AGGREGATE: runs: 1
# SINGLE: "runs":[{"uuid":"[[U:[0-9a-f-]+]]","name":"aggregate","status":0,"simulation_time":0,"timestamp":0,"seed":0,"tags":{}}],"files"
# SINGLE: "functional_instance_groups":[{"type":50,{{[^]]*}}"sources":[{"run":"[[U]]","id":1}],"items":[
# SINGLE: "automatic_bins":[]}]}],"functional_counters"
