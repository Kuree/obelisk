# RUN: %coverage-fixture %t.a.obcov 1 alpha 1
# RUN: %coverage-fixture %t.b.obcov 2 beta 0
# RUN: not obelisk-cov report --format=xml %t.a.obcov 2>&1 | FileCheck %s --check-prefix=BAD-FORMAT
# RUN: obelisk-cov inspect %t.a.obcov | FileCheck %s --check-prefix=INSPECT
# RUN: obelisk-cov merge -o %t.merged.obcov %t.a.obcov %t.b.obcov
# RUN: obelisk-cov report --format=text %t.merged.obcov | FileCheck %s --check-prefix=TEXT
# RUN: obelisk-cov report --format=json --test=alpha %t.merged.obcov | FileCheck %s --check-prefix=JSON
# RUN: obelisk-cov report --format=json %t.merged.obcov | FileCheck %s --check-prefix=MERGED

# Two runs, one hit and one miss, merge into one database that reports every
# metric; the report format must be one of the supported ones.

# INSPECT: format: obcov
# INSPECT: codec-version: 2
# INSPECT-NEXT: checksum: sha256-trailer
# INSPECT: runs: 1
# INSPECT: line-points: 3
# INSPECT: toggle-objects: 1
# INSPECT: functional-types: 1
# INSPECT: functional-formals: 0
# INSPECT: functional-item-templates: 1
# INSPECT: functional-bin-templates: 1
# INSPECT: functional-configurations: 1
# INSPECT: resolved-functional-items: 1
# INSPECT: resolved-functional-bins: 1
# INSPECT: resolved-instances: 1

# BAD-FORMAT: usage:
# BAD-FORMAT-NOT: --format=xml

# TEXT: tests: 2
# TEXT: line: 100.00% (1/1), partial 0
# TEXT: toggle: 50.00% (2/4)
# TEXT: functional: 100.00% (1/1)
# TEXT: type cg (50): 100.00%
# TEXT: instance fixture: 100.00% (1/1)
# TEXT: coverpoint cp: 1/1
# TEXT: bin one: 1 [covered]
# TEXT: exclusions:
# TEXT: line 31: generated

# JSON: "format":"obelisk-coverage-report-v1"
# JSON: "runs":[{"uuid":"00000000-0000-0000-0000-000000000001","name":"alpha"
# JSON: "functional_formals":[]

# The merged JSON report is one complete document (it starts with the format
# tag and ends with its last array) whose rows carry the merged contributors:
# the functional metric is covered, the covered bin has one contributor from
# the run that hit it, the line and toggle points keep only that run's counts,
# and the generated line is an exclusion.
# MERGED: {"format":"obelisk-coverage-report-v1"
# MERGED: "functional":{"available":true,"covered":1,"total":1,"partial":0,"percent":100.000000}},"runs"
# MERGED: "line_points":[{"id":30,{{[^]]*}}"count":1,{{[^]]*}}"contributors":[{"uuid":"00000000-0000-0000-0000-000000000001","name":"alpha","count":1}]},{"id":31,
# MERGED-SAME: {{[^]]*}}"excluded":true,"exclusion_reason":"generated"
# MERGED: "toggles":[{"id":40,
# MERGED: "bits":[{"index":0,"paths":["data[0]"],"zero_to_one":{"count":1,
# MERGED-SAME: "one_to_zero":{"count":1,
# MERGED: {"index":1,"paths":["data[1]"],"zero_to_one":{"count":0,
# MERGED-SAME: "one_to_zero":{"count":0,
# MERGED: "functional_types":[{"id":50,"scope":20,"name":"cg","base":0,
# MERGED: "functional_item_templates":[{{[^]]*}}"flags":0
# MERGED: "functional_configurations":[{"type":50,"configuration":"{{[0-9a-f]+}}","flags":0,"options":[]}],"resolved_functional_items":[
# MERGED-SAME: {"type":50,{{[^]]*}}"id":160,{{[^]]*}}"flags":0
# MERGED: "functional_instance_groups":[{
# MERGED: "sources":[{"run":"00000000-0000-0000-0000-000000000001","id":1},{"run":"00000000-0000-0000-0000-000000000002","id":1}],"items":[{"id":160,
# MERGED: "bins":[{"id":170,"template_bin":70,{{[^]]*}}"count":1,{{[^]]*}}"contributors":[{"uuid":"00000000-0000-0000-0000-000000000001","name":"alpha","count":1,"overflow":false}]}],"automatic_bins":[]
# MERGED: "functional_counters":[{"run":"00000000-0000-0000-0000-000000000001","instance":1,"bin":170,
# MERGED: "exclusions":[{"entity":31,"metric":"line","reason":"generated"},{"entity":32,"metric":"line","reason":"entire generated line"}]}
