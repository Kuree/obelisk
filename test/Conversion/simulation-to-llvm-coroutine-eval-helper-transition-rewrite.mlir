// RUN: obelisk-opt %s --convert-obelisk-sim-processes-to-llvm-coroutines \
// RUN:   > %t
// RUN: FileCheck %s < %t
// RUN: FileCheck %s --check-prefix=NO-PURE-CLONE < %t
// RUN: FileCheck %s --check-prefix=NO-UNSAFE-TWO-STATE < %t

// This preplanned body has no NBA operation, so its shared helper transition
// is independent of the inert static-NBA metadata. The one conversion pass
// must rewrite transitions in the complete Eval call closure, not just in the
// directly tagged body, and retain the Tier-1 coordinator.
module attributes {llvm.data_layout = "e-m:e-p:64:64-i64:64-n8:16:32:64-S128", llvm.target_triple = "x86_64-unknown-linux-gnu", schedule.native_scheduler = 3 : i32} {
