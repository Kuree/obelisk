// RUN: obelisk-opt %s --convert-obelisk-sim-processes-to-llvm-coroutines | FileCheck %s

// Frozen after scheduling. This single-pass fixture has periodic generators on
// bits 0 and 1 of one root; the forwarding alias captures bit 1 through
// descriptor_low. The alias must bind to physical bit offset 9, not bit 0 at 8.
module attributes {llvm.data_layout = "e-m:e-p:64:64-i64:64-n8:16:32:64-S128", llvm.target_triple = "x86_64-unknown-linux-gnu", schedule.native_scheduler = 3 : i32} {
