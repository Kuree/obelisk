// RUN: talos-opt %S/simulation-statement-fusion.mlir '--test-talos-set-module-attributes=attrs="{schedule.native_scheduler = 3 : i32}"' > %t.mlir
// RUN: talos-opt %t.mlir --pass-pipeline='builtin.module(simulation.design(talos-sim-build-compute-graph,talos-sim-materialize-compute-fusion{materialize-eval-bodies=false},schedule-plan-combinational-statements,talos-sim-materialize-compute-fusion{materialize-eval-bodies=false}))' -o %t.fused.mlir
// RUN: FileCheck %s --check-prefix=EARLY --implicit-check-not=__talos_eval_body < %t.fused.mlir
// RUN: talos-opt %t.fused.mlir --pass-pipeline='builtin.module(simulation.design(talos-sim-build-compute-graph,talos-sim-materialize-compute-fusion,talos-sim-build-compute-graph,talos-sim-verify-compute-graph))' | FileCheck %s --check-prefix=LATE --implicit-check-not=producer_and_consumer.__talos_eval_body --implicit-check-not=transform.__talos_eval_body

// Match the driver's early and final fusion rounds. Cloning an evaluator in
// the first round leaves old actor reads alive after statement fusion, hiding
// the fact that both intermediate port values now travel entirely through SSA.
// The separate clocked consumer keeps the final output observable.

// EARLY-LABEL: simulation.func private @__talos_region_kernel_
// EARLY: %[[INPUT:.*]] = simulation.context.storage %arg0[0]
// EARLY: %[[OUTPUT:.*]] = simulation.context.storage %arg0[3]
// EARLY: simulation.ref.load %[[INPUT]]
// EARLY-NOT: simulation.ref.store
// EARLY: %[[RESULT:.*]] = arith.addi
// EARLY-NOT: simulation.ref.store
// EARLY: simulation.ref.store %[[RESULT]] to %[[OUTPUT]]
// EARLY-NOT: simulation.ref.store
// EARLY: simulation.suspend.any %[[INPUT]] edges [0]

// LATE-LABEL: simulation.func private @__talos_region_kernel_{{.*}}.__talos_eval_body_
// LATE: %[[INPUT:.*]] = simulation.context.storage %arg0[0]
// LATE: %[[OUTPUT:.*]] = simulation.context.storage %arg0[3]
// LATE: simulation.ref.load %[[INPUT]]
// LATE-NOT: simulation.ref.store
// LATE: %[[RESULT:.*]] = arith.addi
// LATE-NOT: simulation.ref.store
// LATE: simulation.ref.store %[[RESULT]] to %[[OUTPUT]]
// LATE-NOT: simulation.ref.store
// LATE: simulation.return
