// RUN: obelisk-opt %s --convert-obelisk-sim-processes-to-llvm-coroutines | FileCheck %s

// Frozen post-planning Simulation IR. The periodic generator toggles bit 1 of
// a two-bit vector. A wide change wait must join periodic direct dispatch,
// while a wide posedge wait observes only expression LSB bit 0 per IEEE
// 1800-2017 9.4.2 and must remain event-driven.
module attributes {llvm.data_layout = "e-m:e-p:64:64-i64:64-n8:16:32:64-S128", llvm.target_triple = "x86_64-unknown-linux-gnu", obelisk.native_scheduler = 3 : i32} {
  obelisk_sim.design @wide_periodic attributes {compute_graph = #obelisk_sim.graph<version = 1, vpi = off, workers = 1, nodes = [#obelisk_sim.fragment<id = 0, function = @change, block = 0, region = active, action = continue, tier = native, cost = 0, lane = 0, twoState = true, effects = []>, #obelisk_sim.fragment<id = 1, function = @change, block = 1, region = active, action = suspend_change, tier = native, cost = 1, lane = 0, twoState = true, effects = [#obelisk_sim.effect<effect = watch, resource = storage, target = descriptor, descriptor = 0, formal = 0, low = 0, width = 2, dynamic = false, deferred = false, trigger = change>]>, #obelisk_sim.fragment<id = 2, function = @change, block = 2, region = active, action = continue, tier = native, cost = 7, lane = 0, twoState = true, effects = [#obelisk_sim.effect<effect = read, resource = storage, target = descriptor, descriptor = 1, formal = 0, low = 0, width = 1, dynamic = false, deferred = false, trigger = none>, #obelisk_sim.effect<effect = write, resource = storage, target = descriptor, descriptor = 1, formal = 0, low = 0, width = 1, dynamic = false, deferred = false, trigger = none>]>, #obelisk_sim.fragment<id = 3, function = @clock, block = 0, region = active, action = continue, tier = native, cost = 0, lane = 0, twoState = true, effects = []>, #obelisk_sim.fragment<id = 4, function = @clock, block = 1, region = active, action = suspend_delay, tier = native, cost = 2, lane = 0, twoState = true, effects = []>, #obelisk_sim.fragment<id = 5, function = @clock, block = 2, region = active, action = continue, tier = native, cost = 7, lane = 0, twoState = true, effects = [#obelisk_sim.effect<effect = read, resource = storage, target = descriptor, descriptor = 0, formal = 0, low = 1, width = 1, dynamic = false, deferred = false, trigger = none>, #obelisk_sim.effect<effect = write, resource = storage, target = descriptor, descriptor = 0, formal = 0, low = 1, width = 1, dynamic = false, deferred = false, trigger = none>]>, #obelisk_sim.fragment<id = 6, function = @edge, block = 0, region = active, action = continue, tier = native, cost = 0, lane = 0, twoState = true, effects = []>, #obelisk_sim.fragment<id = 7, function = @edge, block = 1, region = active, action = suspend_edge, tier = native, cost = 1, lane = 0, twoState = true, effects = [#obelisk_sim.effect<effect = watch, resource = storage, target = descriptor, descriptor = 0, formal = 0, low = 0, width = 2, dynamic = false, deferred = false, trigger = posedge>]>, #obelisk_sim.fragment<id = 8, function = @edge, block = 2, region = active, action = continue, tier = native, cost = 7, lane = 0, twoState = true, effects = [#obelisk_sim.effect<effect = read, resource = storage, target = descriptor, descriptor = 2, formal = 0, low = 0, width = 1, dynamic = false, deferred = false, trigger = none>, #obelisk_sim.effect<effect = write, resource = storage, target = descriptor, descriptor = 2, formal = 0, low = 0, width = 1, dynamic = false, deferred = false, trigger = none>]>, #obelisk_sim.fragment<id = 9, function = @root, block = 0, region = active, action = terminate, tier = native, cost = 7, lane = 0, twoState = true, effects = []>], edges = [#obelisk_sim.edge<source = 0, target = 1, kind = process_order>, #obelisk_sim.edge<source = 1, target = 2, kind = resume>, #obelisk_sim.edge<source = 2, target = 1, kind = process_order>, #obelisk_sim.edge<source = 3, target = 4, kind = process_order>, #obelisk_sim.edge<source = 4, target = 5, kind = resume>, #obelisk_sim.edge<source = 5, target = 1, kind = sensitivity, resource = <effect = watch, resource = storage, target = descriptor, descriptor = 0, formal = 0, low = 0, width = 2, dynamic = false, deferred = false, trigger = change>>, #obelisk_sim.edge<source = 5, target = 4, kind = process_order>, #obelisk_sim.edge<source = 5, target = 7, kind = sensitivity, resource = <effect = watch, resource = storage, target = descriptor, descriptor = 0, formal = 0, low = 0, width = 2, dynamic = false, de