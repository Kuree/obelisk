// RUN: obelisk-opt %s --convert-obelisk-sim-processes-to-llvm-coroutines \
// RUN:   | FileCheck %s

// This preplanned Eval body invokes an NBA-bearing direct callee twice. The
// callee's site is locally acyclic and unique, but its generated call-graph
// multiplicity makes a 64-bit root accumulator unsafe: one old-to-final commit
// could erase intermediate edge events. Eval must retain runtime ordering.
module attributes {llvm.data_layout = "e-m:e-p:64:64-i64:64-n8:16:32:64-S128", llvm.target_triple = "x86_64-unknown-linux-gnu", obelisk.native_scheduler = 3 : i32} {
  obelisk_sim.design @eval_wide_dynamic_nba attributes {compute_graph = #obelisk_sim.graph<version = 1, vpi = off, workers = 1, nodes = [#obelisk_sim.fragment<id = 0, function = @clock, block = 0, region = active, action = continue, tier = native, cost = 0, lane = 0, twoState = true, effects = []>, #obelisk_sim.fragment<id = 1, function = @clock, block = 1, region = active, action = suspend_delay, tier = native, cost = 2, lane = 0, twoState = true, effects = []>, #obelisk_sim.fragment<id = 2, function = @clock, block = 2, region = active, action = continue, tier = native, cost = 7, lane = 0, twoState = true, effects = [#obelisk_sim.effect<effect = read, resource = storage, target = descriptor, descriptor = 0, formal = 0, low = 0, width = 1, dynamic = false, deferred = false, trigger = none>, #obelisk_sim.effect<effect = write, resource = storage, target = descriptor, descriptor = 0, formal = 0, low = 0, width = 1, dynamic = false, deferred = false, trigger = none>]>, #obelisk_sim.fragment<id = 3, function = @root, block = 0, region = active, action = terminate, tier = native, cost = 5, lane = 0, twoState = true, effects = []>, #obelisk_sim.fragment<id = 4, function = @update, block = 0, region = active, action = continue, tier = native, cost = 0, lane = 0, twoState = true, effects = []>, #obelisk_sim.fragment<id = 5, function = @update, block = 1, region = active, action = suspend_change, tier = native, cost = 1, lane = 0, twoState = true, effects = [#obelisk_sim.effect<effect = watch, resource = storage, target = descriptor, descriptor = 0, formal = 0, low = 0, width = 1, dynamic = false, deferred = false, trigger = change>]>, #obelisk_sim.fragment<id = 6, function = @update, block = 2, region = active, action = continue, tier = native, cost = 8, lane = 0, twoState = true, effects = [#obelisk_sim.effect<effect = read, resource = storage, target = descriptor, descriptor = 2, formal = 0, low = 0, width = 64, dynamic = false, deferred = false, trigger = none>, #obelisk_sim.effect<effect = nba, resource = storage, target = descriptor, descriptor = 1, formal = 0, low = 0, width = 64, dynamic = true, deferred = false, trigger = none>]>, #obelisk_sim.nba_commit<id = 7, slots = [], accumulatorSites = [0], frontierSites = [], effect = <effect = write, resource = storage, target = descriptor, descriptor = 1, formal = 0, low = 0, width = 64, dynamic = false, deferred = false, trigger = none>>], edges = [#obelisk_sim.edge<source = 0, target = 1, kind = process_order>, #obelisk_sim.edge<source = 1, target = 2, kind = resume>, #obelisk_sim.edge<source = 2, target = 1, kind = process_order>, #obelisk_sim.edge<source = 2, target = 5, kind = sensitivity, resource = <effect = watch, resource = storage, target = descriptor, descriptor = 0, formal = 0, low = 0, width = 1, dynamic = false, deferred = false, trigger = change>>, #obelisk_sim.edge<source = 3, target = 0, kind = spawn>, #obelisk_sim.edge<source = 3, target = 4, kind = spawn>, #obelisk_sim.edge<source = 4, target = 5, kind = process_order>, #obelisk_sim.edge<source = 5, target = 6, kind = resume>, #obelisk_sim.edge<source = 6, target = 5, kind = process_order>, #obelisk_sim.edge<source = 6, target = 7, kind = nba_stage, resource = <effect = nba, resource = storage, target = descriptor, descriptor = 1, formal = 0, low = 0, width = 64, dynamic = true, deferred = false, trigger = none>>], regions = [#obelisk_sim.region<kind = active, groups = [#obelisk_sim.group<fragments = [0], schedule = acyclic, feedback = []>, #obelisk_sim.group<fragments = [2], schedule = acyclic, feedback = []>, #obelisk_sim.group<fragments = [1], schedule = acyclic, feedback = []>, #obelisk_sim.group<fragments = [3], schedule = acyclic, feedback = []>, #obelisk_sim.group<fragments = [4], schedule = acyclic, feedback = []>, #obelisk_sim.group<fragments = [6], schedule = acyclic, feedback = []>, #obelisk_sim.group<fragments = [5], schedule = acyclic, feedback = []>]>, #obelisk_sim.region<kind = nba, groups = [#obelisk_sim.group<fragments = [7], schedule = acyclic, feedback = []>]>, #obelisk_sim.region<kind = observed, groups = []>, #obelisk_sim.region<kind = reactive, groups = []>, #obelisk_sim.region<kind = postponed, groups = []>]>, obelisk_sim.compute_kernels = [#obelisk_sim.kernel<id = 0, region = active, schedule = acyclic, lane = 0, cost = 22, loweringReady = true, fragments = [0, 2, 1, 3, 4, 6]>, #obelisk_sim.kernel<id = 1, region = active, schedule = acyclic, lane = 0, cost = 1, loweringReady = true, fragments = [5]>, #obelisk_sim.kernel<id = 2, region = nba, schedule = acyclic, lane = 0, cost = 1, loweringReady = true, fragments = [7]>], obelisk_sim.static_specialization = #obelisk_sim.static_specialization<version = 1, maxPackedWidth = 64, sourceGraph = <version = 1, vpi = off, workers = 1, nodes = [#obelisk_sim.fragment<id = 0, function = @clock, block = 0, region = active, action = continue, tier = native, cost = 0, lane = 0, twoState = true, effects = []>, #obelisk_sim.fragment<id = 1, function = @clock, block = 1, region = active, action = suspend_delay, tier = native, cost = 2, lane = 0, twoState = true, effects = []>, #obelisk_sim.fragment<id = 2, function = @clock, block = 2, region = active, action = continue, tier = native, cost = 7, lane = 0, twoState = true, effects = [#obelisk_sim.effect<effect = read, resource = storage, target = descriptor, descriptor = 0, formal = 0, low = 0, width = 1, dynamic = false, deferred = false, trigger = none>, #obelisk_sim.effect<effect = write, resource = storage, target = descriptor, descriptor = 0, formal = 0, low = 0, width = 1, dynamic = false, deferred = false, trigger = none>]>, #obelisk_sim.fragment<id = 3, function = @root, block = 0, region = active, action = terminate, tier = native, cost = 5, lane = 0, twoState = true, effects = []>, #obelisk_sim.fragment<id = 4, function = @update, block = 0, region = active, action = continue, tier = native, cost = 0, lane = 0, twoState = true, effects = []>, #obelisk_sim.fragment<id = 5, function = @update, block = 1, region = active, action = suspend_change, tier = native, cost = 1, lane = 0, twoState = true, effects = [#obelisk_sim.effect<effect = watch, resource = storage, target = descriptor, descriptor = 0, formal = 0, low = 0, width = 1, dynamic = false, deferred = false, trigger = change>]>, #obelisk_sim.fragment<id = 6, function = @update, block = 2, region = active, action = continue, tier = native, cost = 8, lane = 0, twoState = true, effects = [#obelisk_sim.effect<effect = read, resource = storage, target = descriptor, descriptor = 2, formal = 0, low = 0, width = 64, dynamic = false, deferred = false, trigger = none>, #obelisk_sim.effect<effect = nba, resource = storage, target = descriptor, descriptor = 1, formal = 0, low = 0, width = 64, dynamic = true, deferred = false, trigger = none>]>, #obelisk_sim.nba_commit<id = 7, slots = [], accumulatorSites = [0], frontierSites = [], effect = <effect = write, resource = storage, target = descriptor, descriptor = 1, formal = 0, low = 0, width = 64, dynamic = false, deferred = false, trigger = none>>], edges = [#obelisk_sim.edge<source = 0, target = 1, kind = process_order>, #obelisk_sim.edge<source = 1, target = 2, kind = resume>, #obelisk_sim.edge<source = 2, target = 1, kind = process_order>, #obelisk_sim.edge<source = 2, target = 5, kind = sensitivity, resource = <effect = watch, resource = storage, target = descriptor, descriptor = 0, formal = 0, low = 0, width = 1, dynamic = false, deferred = false, trigger = change>>, #obelisk_sim.edge<source = 3, target = 0, kind = spawn>, #obelisk_sim.edge<source = 3, target = 4, kind = spawn>, #obelisk_sim.edge<source = 4, target = 5, kind = process_order>, #obelisk_sim.edge<source = 5, target = 6, kind = resume>, #obelisk_sim.edge<source = 6, target = 5, kind = process_order>, #obelisk_sim.edge<source = 6, target = 7, kind = nba_stage, resource = <effect = nba, resource = storage, target = descriptor, descriptor = 1, formal = 0, low = 0, width = 64, dynamic = true, deferred = false, trigger = none>>], regions = [#obelisk_sim.region<kind = active, groups = [#obelisk_sim.group<fragments = [0], schedule = acyclic, feedback = []>, #obelisk_sim.group<fragments = [2], schedule = acyclic, feedback = []>, #obelisk_sim.group<fragments = [1], schedule = acyclic, feedback = []>, #obelisk_sim.group<fragments = [3], schedule = acyclic, feedback = []>, #obelisk_sim.group<fragments = [4], schedule = acyclic, feedback = []>, #obelisk_sim.group<fragments = [6], schedule = acyclic, feedback = []>, #obelisk_sim.group<fragments = [5], schedule = acyclic, feedback = []>]>, #obelisk_sim.region<kind = nba, groups = [#obelisk_sim.group<fragments = [7], schedule = acyclic, feedback = []>]>, #obelisk_sim.region<kind = observed, groups = []>, #obelisk_sim.region<kind = reactive, groups = []>, #obelisk_sim.region<kind = postponed, groups = []>]>, roots = [#obelisk_sim.static_state_root<descriptor = 0, width = 1, direct = true, guarded = false, nba = false>, #obelisk_sim.static_state_root<descriptor = 1, width = 64, direct = true, guarded = false, nba = true>, #obelisk_sim.static_state_root<descriptor = 2, width = 64, direct = true, guarded = false, nba = false>], actorRoots = [#obelisk_sim.static_actor_root<function = @clock, descriptor = 0, read = true, write = true>, #obelisk_sim.static_actor_root<function = @update, descriptor = 0, read = true, write = false>, #obelisk_sim.static_actor_root<function = @update, descriptor = 2, read = true, write = false>], nbaRoots = [1]>, obelisk_sim.static_superstep = #obelisk_sim.static_superstep<version = 1, sourceGraph = <version = 1, vpi = off, workers = 1, nodes = [#obelisk_sim.fragment<id = 0, function = @clock, block = 0, region = active, action = continue, tier = native, cost = 0, lane = 0, twoState = true, effects = []>, #obelisk_sim.fragment<id = 1, function = @clock, block = 1, region = active, action = suspend_delay, tier = native, cost = 2, lane = 0, twoState = true, effects = []>, #obelisk_sim.fragment<id = 2, function = @clock, block = 2, region = active, action = continue, tier = native, cost = 7, lane = 0, twoState = true, effects = [#obelisk_sim.effect<effect = read, resource = storage, target = descriptor, descriptor = 0, formal = 0, low = 0, width = 1, dynamic = false, deferred = false, trigger = none>, #obelisk_sim.effect<effect = write, resource = storage, target = descriptor, descriptor = 0, formal = 0, low = 0, width = 1, dynamic = false, deferred = false, trigger = none>]>, #obelisk_sim.fragment<id = 3, function = @root, block = 0, region = active, action = terminate, tier = native, cost = 5, lane = 0, twoState = true, effects = []>, #obelisk_sim.fragment<id = 4, function = @update, block = 0, region = active, action = continue, tier = native, cost = 0, lane = 0, twoState = true, effects = []>, #obelisk_sim.fragment<id = 5, function = @update, block = 1, region = active, action = suspend_change, tier = native, cost = 1, lane = 0, twoState = true, effects = [#obelisk_sim.effect<effect = watch, resource = storage, target = descriptor, descriptor = 0, formal = 0, low = 0, width = 1, dynamic = false, deferred = false, trigger = change>]>, #obelisk_sim.fragment<id = 6, function = @update, block = 2, region = active, action = continue, tier = native, cost = 8, lane = 0, twoState = true, effects = [#obelisk_sim.effect<effect = read, resource = storage, target = descriptor, descriptor = 2, formal = 0, low = 0, width = 64, dynamic = false, deferred = false, trigger = none>, #obelisk_sim.effect<effect = nba, resource = storage, target = descriptor, descriptor = 1, formal = 0, low = 0, width = 64, dynamic = true, deferred = false, trigger = none>]>, #obelisk_sim.nba_commit<id = 7, slots = [], accumulatorSites = [0], frontierSites = [], effect = <effect = write, resource = storage, target = descriptor, descriptor = 1, formal = 0, low = 0, width = 64, dynamic = false, deferred = false, trigger = none>>], edges = [#obelisk_sim.edge<source = 0, target = 1, kind = process_order>, #obelisk_sim.edge<source = 1, target = 2, kind = resume>, #obelisk_sim.edge<source = 2, target = 1, kind = process_order>, #obelisk_sim.edge<source = 2, target = 5, kind = sensitivity, resource = <effect = watch, resource = storage, target = descriptor, descriptor = 0, formal = 0, low = 0, width = 1, dynamic = false, deferred = false, trigger = change>>, #obelisk_sim.edge<source = 3, target = 0, kind = spawn>, #obelisk_sim.edge<source = 3, target = 4, kind = spawn>, #obelisk_sim.edge<source = 4, target = 5, kind = process_order>, #obelisk_sim.edge<source = 5, target = 6, kind = resume>, #obelisk_sim.edge<source = 6, target = 5, kind = process_order>, #obelisk_sim.edge<source = 6, target = 7, kind = nba_stage, resource = <effect = nba, resource = storage, target = descriptor, descriptor = 1, formal = 0, low = 0, width = 64, dynamic = true, deferred = false, trigger = none>>], regions = [#obelisk_sim.region<kind = active, groups = [#obelisk_sim.group<fragments = [0], schedule = acyclic, feedback = []>, #obelisk_sim.group<fragments = [2], schedule = acyclic, feedback = []>, #obelisk_sim.group<fragments = [1], schedule = acyclic, feedback = []>, #obelisk_sim.group<fragments = [3], schedule = acyclic, feedback = []>, #obelisk_sim.group<fragments = [4], schedule = acyclic, feedback = []>, #obelisk_sim.group<fragments = [6], schedule = acyclic, feedback = []>, #obelisk_sim.group<fragments = [5], schedule = acyclic, feedback = []>]>, #obelisk_sim.region<kind = nba, groups = [#obelisk_sim.group<fragments = [7], schedule = acyclic, feedback = []>]>, #obelisk_sim.region<kind = observed, groups = []>, #obelisk_sim.region<kind = reactive, groups = []>, #obelisk_sim.region<kind = postponed, groups = []>]>, actors = [@root, @clock, @update]>, obelisk_sim.three_tier_schedule = #obelisk_sim.three_tier_schedule<version = 1, sourceGraph = <version = 1, vpi = off, workers = 1, nodes = [#obelisk_sim.fragment<id = 0, function = @clock, block = 0, region = active, action = continue, tier = native, cost = 0, lane = 0, twoState = true, effects = []>, #obelisk_sim.fragment<id = 1, function = @clock, block = 1, region = active, action = suspend_delay, tier = native, cost = 2, lane = 0, twoState = true, effects = []>, #obelisk_sim.fragment<id = 2, function = @clock, block = 2, region = active, action = continue, tier = native, cost = 7, lane = 0, twoState = true, effects = [#obelisk_sim.effect<effect = read, resource = storage, target = descriptor, descriptor = 0, formal = 0, low = 0, width = 1, dynamic = false, deferred = false, trigger = none>, #obelisk_sim.effect<effect = write, resource = storage, target = descriptor, descriptor = 0, formal = 0, low = 0, width = 1, dynamic = false, deferred = false, trigger = none>]>, #obelisk_sim.fragment<id = 3, function = @root, block = 0, region = active, action = terminate, tier = native, cost = 5, lane = 0, twoState = true, effects = []>, #obelisk_sim.fragment<id = 4, function = @update, block = 0, region = active, action = continue, tier = native, cost = 0, lane = 0, twoState = true, effects = []>, #obelisk_sim.fragment<id = 5, function = @update, block = 1, region = active, action = suspend_change, tier = native, cost = 1, lane = 0, twoState = true, effects = [#obelisk_sim.effect<effect = watch, resource = storage, target = descriptor, descriptor = 0, formal = 0, low = 0, width = 1, dynamic = false, deferred = false, trigger = change>]>, #obelisk_sim.fragment<id = 6, function = @update, block = 2, region = active, action = continue, tier = native, cost = 8, lane = 0, twoState = true, effects = [#obelisk_sim.effect<effect = read, resource = storage, target = descriptor, descriptor = 2, formal = 0, low = 0, width = 64, dynamic = false, deferred = false, trigger = none>, #obelisk_sim.effect<effect = nba, resource = storage, target = descriptor, descriptor = 1, formal = 0, low = 0, width = 64, dynamic = true, deferred = false, trigger = none>]>, #obelisk_sim.nba_commit<id = 7, slots = [], accumulatorSites = [0], frontierSites = [], effect = <effect = write, resource = storage, target = descriptor, descriptor = 1, formal = 0, low = 0, width = 64, dynamic = false, deferred = false, trigger = none>>], edges = [#obelisk_sim.edge<source = 0, target = 1, kind = process_order>, #obelisk_sim.edge<source = 1, target = 2, kind = resume>, #obelisk_sim.edge<source = 2, target = 1, kind = process_order>, #obelisk_sim.edge<source = 2, target = 5, kind = sensitivity, resource = <effect = watch, resource = storage, target = descriptor, descriptor = 0, formal = 0, low = 0, width = 1, dynamic = false, deferred = false, trigger = change>>, #obelisk_sim.edge<source = 3, target = 0, kind = spawn>, #obelisk_sim.edge<source = 3, target = 4, kind = spawn>, #obelisk_sim.edge<source = 4, target = 5, kind = process_order>, #obelisk_sim.edge<source = 5, target = 6, kind = resume>, #obelisk_sim.edge<source = 6, target = 5, kind = process_order>, #obelisk_sim.edge<source = 6, target = 7, kind = nba_stage, resource = <effect = nba, resource = storage, target = descriptor, descriptor = 1, formal = 0, low = 0, width = 64, dynamic = true, deferred = false, trigger = none>>], regions = [#obelisk_sim.region<kind = active, groups = [#obelisk_sim.group<fragments = [0], schedule = acyclic, feedback = []>, #obelisk_sim.group<fragments = [2], schedule = acyclic, feedback = []>, #obelisk_sim.group<fragments = [1], schedule = acyclic, feedback = []>, #obelisk_sim.group<fragments = [3], schedule = acyclic, feedback = []>, #obelisk_sim.group<fragments = [4], schedule = acyclic, feedback = []>, #obelisk_sim.group<fragments = [6], schedule = acyclic, feedback = []>, #obelisk_sim.group<fragments = [5], schedule = acyclic, feedback = []>]>, #obelisk_sim.region<kind = nba, groups = [#obelisk_sim.group<fragments = [7], schedule = acyclic, feedback = []>]>, #obelisk_sim.region<kind = observed, groups = []>, #obelisk_sim.region<kind = reactive, groups = []>, #obelisk_sim.region<kind = postponed, groups = []>]>, ownerCount = 3, triggers = [#obelisk_sim.trigger_group<id = 0, key = <resource = storage, descriptor = 0, low = 0, width = 1, edge = change>>], kernels = [#obelisk_sim.scheduled_kernel<id = 0, owner = 1, readyBit = 0, tier = tier1, region = active, schedule = acyclic, shared = true, loweringReady = true, twoStateEligible = true, promotionRoots = [#obelisk_sim.inductive_root<resource = storage, descriptor = 0>, #obelisk_sim.inductive_root<resource = storage, descriptor = 2>], fragments = [0, 2, 1, 3, 4, 6]>, #obelisk_sim.scheduled_kernel<id = 1, owner = 0, readyBit = 0, tier = tier1, region = active, schedule = acyclic, shared = false, loweringReady = true, twoStateEligible = true, promotionRoots = [#obelisk_sim.inductive_root<resource = storage, descriptor = 0>], fragments = [5]>, #obelisk_sim.scheduled_kernel<id = 2, owner = 2, readyBit = 0, tier = tier1, region = nba, schedule = acyclic, shared = true, loweringReady = true, twoStateEligible = false, promotionRoots = [], fragments = [7]>], roots = [#obelisk_sim.scheduled_root<resource = storage, descriptor = 0, low = 0, width = 1, owner = 1, tier = tier1>, #obelisk_sim.scheduled_root<resource = storage, descriptor = 1, low = 0, width = 64, owner = 2, tier = tier1>], ingress = [#obelisk_sim.scheduler_ingress<trigger = 0, owner = 0, readyBit = 0, fragment = 5>]>} {
    obelisk_sim.scope.decl 0
    obelisk_sim.code_unit.decl 1 in 0 root_initializer hierarchy "eval_wide_dynamic_nba.root"
    obelisk_sim.code_unit.decl 2 in 0 always hierarchy "eval_wide_dynamic_nba.clock"
    obelisk_sim.code_unit.decl 3 in 0 always hierarchy "eval_wide_dynamic_nba.update"
    obelisk_sim.storage.decl 0 in 0 : !obelisk_sim.logic<1> design {observability = 0 : i32}
    obelisk_sim.storage.decl 1 in 0 : !obelisk_sim.unpacked_array<0 : 1 x !obelisk_sim.logic<32>> design {observability = 0 : i32}
    obelisk_sim.storage.decl 2 in 0 : !obelisk_sim.logic<64> design {observability = 0 : i32}
    obelisk_sim.func @root(%arg0: !obelisk_sim.context {obelisk_sim.capture_kind = 0 : i32}) attributes {code_unit_id = 1 : i64, domain = 0 : i32, effect_summary = [], entry_kind = 0 : i32, fragment_abi = #obelisk_sim.fragment_abi<version = 1, fragments = [3]>, home_region = 2 : i32} {
      %0 = obelisk_sim.context.storage %arg0[0] : !obelisk_sim.ref<!obelisk_sim.logic<1>>
      %1 = obelisk_sim.context.storage %arg0[1] : !obelisk_sim.ref<!obelisk_sim.unpacked_array<0 : 1 x !obelisk_sim.logic<32>>>
      %2 = obelisk_sim.context.storage %arg0[2] : !obelisk_sim.ref<!obelisk_sim.logic<64>>
      %3 = obelisk_sim.spawn @clock(%arg0, %0) : !obelisk_sim.context, !obelisk_sim.ref<!obelisk_sim.logic<1>> -> !obelisk_sim.process
      %4 = obelisk_sim.spawn @update(%arg0, %0, %1, %2) : !obelisk_sim.context, !obelisk_sim.ref<!obelisk_sim.logic<1>>, !obelisk_sim.ref<!obelisk_sim.unpacked_array<0 : 1 x !obelisk_sim.logic<32>>>, !obelisk_sim.ref<!obelisk_sim.logic<64>> -> !obelisk_sim.process
      obelisk_sim.return
    }
    obelisk_sim.func @clock(%arg0: !obelisk_sim.context {obelisk_sim.capture_kind = 0 : i32}, %arg1: !obelisk_sim.ref<!obelisk_sim.logic<1>> {obelisk_sim.capture_kind = 3 : i32, obelisk_sim.descriptor_id = 0 : i64}) attributes {code_unit_id = 2 : i64, domain = 0 : i32, effect_summary = [#obelisk_sim.effect<effect = read, resource = storage, target = descriptor, descriptor = 0, formal = 0, low = 0, width = 1, dynamic = false, deferred = false, trigger = none>, #obelisk_sim.effect<effect = write, resource = storage, target = descriptor, descriptor = 0, formal = 0, low = 0, width = 1, dynamic = false, deferred = false, trigger = none>], entry_kind = 3 : i32, fragment_abi = #obelisk_sim.fragment_abi<version = 1, fragments = [0, 1, 2]>, home_region = 2 : i32} {
      cf.br ^bb1
    ^bb1:  // 2 preds: ^bb0, ^bb2
      %0 = obelisk_sim.time.constant 1
      obelisk_sim.suspend.delay %0 to ^bb2 {site = #obelisk_sim.continuation<id = 2>, timing = #obelisk_sim.timing_site<id = 0, kind = calendar>}
    ^bb2:  // pred: ^bb1
      %1 = obelisk_sim.ref.load %arg1 : !obelisk_sim.ref<!obelisk_sim.logic<1>> -> !obelisk_sim.logic<1>
      %2 = obelisk_sim.logic.unary bit_not %1 : (!obelisk_sim.logic<1>) -> !obelisk_sim.logic<1>
      obelisk_sim.ref.store %2 to %arg1 : !obelisk_sim.logic<1>, !obelisk_sim.ref<!obelisk_sim.logic<1>>
      cf.br ^bb1
    }
    obelisk_sim.func @update(%arg0: !obelisk_sim.context {obelisk_sim.capture_kind = 0 : i32}, %arg1: !obelisk_sim.ref<!obelisk_sim.logic<1>> {obelisk_sim.capture_kind = 3 : i32, obelisk_sim.descriptor_id = 0 : i64}, %arg2: !obelisk_sim.ref<!obelisk_sim.unpacked_array<0 : 1 x !obelisk_sim.logic<32>>> {obelisk_sim.capture_kind = 3 : i32, obelisk_sim.descriptor_id = 1 : i64}, %arg3: !obelisk_sim.ref<!obelisk_sim.logic<64>> {obelisk_sim.capture_kind = 3 : i32, obelisk_sim.descriptor_id = 2 : i64}) attributes {code_unit_id = 3 : i64, domain = 0 : i32, effect_summary = [#obelisk_sim.effect<effect = read, resource = storage, target = descriptor, descriptor = 2, formal = 0, low = 0, width = 64, dynamic = false, deferred = false, trigger = none>, #obelisk_sim.effect<effect = watch, resource = storage, target = descriptor, descriptor = 0, formal = 0, low = 0, width = 1, dynamic = false, deferred = false, trigger = change>, #obelisk_sim.effect<effect = nba, resource = storage, target = descriptor, descriptor = 1, formal = 0, low = 0, width = 64, dynamic = true, deferred = false, trigger = none>], entry_kind = 3 : i32, fragment_abi = #obelisk_sim.fragment_abi<version = 1, fragments = [4, 5, 6]>, home_region = 2 : i32, obelisk.eval.body = @update.__obelisk_eval_body_0} {
      cf.br ^bb1
    ^bb1:  // 2 preds: ^bb0, ^bb2
      obelisk_sim.suspend.change %arg1 to ^bb2 {site = #obelisk_sim.continuation<id = 6>} : !obelisk_sim.ref<!obelisk_sim.logic<1>>
    ^bb2:  // pred: ^bb1
      obelisk_sim.call @stage(%arg0) : (!obelisk_sim.context) -> ()
      obelisk_sim.call @stage(%arg0) : (!obelisk_sim.context) -> ()
