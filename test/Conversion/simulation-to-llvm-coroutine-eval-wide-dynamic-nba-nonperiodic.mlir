      %1 = simulation.ref.array_element %arg2[%0] : (!simulation.ref<!simulation.unpacked_array<0 : 31 x !simulation.logic<32>>>, !simulation.logic<64>) -> !simulation.ref<!simulation.logic<32>>
      %2 = simulation.logic.constant -1515870811 : i32, 0 : i32 : !simulation.logic<32>
      simulation.nba.enqueue %2 to %1 {schedule.eval.origin_nba_site = 0 : i64, site = #schedule.nba_site<id = 0, commit = 7, storage = root_accumulator>} : (!simulation.logic<32>, !simulation.ref<!simulation.logic<32>>) -> ()
      simulation.return
    }
  }
}

// The array element of a captured root is addressable by a queue record, so
// the ordered generated queue owns every execution of this site. Mixed
// ingress rules out the one-entry latch, not the queue.
