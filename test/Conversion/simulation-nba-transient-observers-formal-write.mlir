// RUN: obelisk-opt %s --split-input-file --pass-pipeline='builtin.module(obelisk_sim.design(obelisk-sim-materialize-compute-fusion))' | FileCheck %s

// IEEE 1800-2023 13.5 writes an `output` actual when the task returns. The
// actual reaches the task as a reference, so only the task's formal-target
// effect records the write. Resolving it through the call site keeps the NBA
// observer analysis available for the whole design instead of giving up, and
// still counts the task as a writer of that actual.
//  - resolved: the task writes `snap`, which nothing watches. `single` gets
//    one write per activation of a free-running clock and needs no mask.
//  - clobbered: the task also writes `clk`, so the clock is no longer
//    free-running and `single` keeps its transient mask.
// Both fixtures are the -O0 simulation IR of
//
//   logic clk = 0; always #5 clk = ~clk;
//   logic [7:0] single = 0; int n = 0;
//   always @(single) n = n + 1;
//   always @(posedge clk) single <= single + 1;
//
// plus a task with one output formal, called from an initial block, with the
// observer inventory removed so this pass computes it. Storage ids: clk=0,
// single=1, n=2.

// CHECK-LABEL: obelisk_sim.design @resolved
// CHECK-SAME: schedule.nba.change_watched = array<i64>
// CHECK-SAME: schedule.nba.transient_observable = array<i64: 0>

#loc = loc("test/Driver/nba-transient-observers-formal-write.sv":23:1)
module attributes {obelisk.coverage.language_version = 2023 : i32} {
  obelisk_sim.design @resolved attributes {compute_graph = #schedule.graph<version = 1, vpi = off, workers = 1, nodes = [#schedule.fragment<id = 0, function = @__obelisk_root, block = 0, region = active, action = terminate, tier = native, cost = 23, lane = 0, twoState = true, effects = [#schedule.effect<effect = write, resource = storage, target = descriptor, descriptor = 0, formal = 0, low = 0, width = 1, dynamic = false, deferred = false, trigger = none>, #schedule.effect<effect = write, resource = storage, target = descriptor, descriptor = 1, formal = 0, low = 0, width = 8, dynamic = false, deferred = false, trigger = none>, #schedule.effect<effect = write, resource = storage, target = descriptor, descriptor = 2, formal = 0, low = 0, width = 32, dynamic = false, deferred = false, trigger = none>]>, #schedule.fragment<id = 1, function = @unit_1, block = 0, region = active, action = continue, tier = native, cost = 1, lane = 0, twoState = true, effects = []>, #schedule.fragment<id = 2, function = @unit_1, block = 1, region = active, action = suspend_delay, tier = native, cost = 1, lane = 0, twoState = true, effects = []>, #schedule.fragment<id = 3, function = @unit_1, block = 2, region = active, action = continue, tier = native, cost = 7, lane = 0, twoState = false, effects = [#schedule.effect<effect = read, resource = storage, target = descriptor, descriptor = 0, formal = 0, low = 0, width = 1, dynamic = false, deferred = false, trigger = none>, #schedule.effect<effect = write, resource = storage, target = descriptor, descriptor = 0, formal = 0, low = 0, width = 1, dynamic = false, deferred = false, trigger = none>]>, #schedule.fragment<id = 4, function = @unit_4, block = 0, region = active, action = continue, tier = native, cost = 1, lane = 0, twoState = true, effects = []>, #schedule.fragment<id = 5, function = @unit_4, block = 1, region = active, action = suspend_change, tier = native, cost = 1, lane = 0, twoState = true, effects = [#schedule.effect<effect = watch, resource = storage, target = descriptor, descriptor = 1, formal = 0, low = 0, width = 8, dynamic = false, deferred = false, trigger = change>]>, #schedule.fragment<id = 6, function = @unit_4, block = 2, region = active, action = continue, tier = native, cost = 7, lane = 0, twoState = true, effects = [#schedule.effect<effect = read, resource = storage, target = descriptor, descriptor = 2, formal = 0, low = 0, width = 32, dynamic = false, deferred = false, trigger = none>, #schedule.effect<effect = write, resource = storage, target = descriptor, descriptor = 2, formal = 0, low = 0, width = 32, dynamic = false, deferred = false, trigger = none>]>, #schedule.fragment<id = 7, function = @unit_5, block = 0, region = active, action = continue, tier = native, cost = 1, lane = 0, twoState = true, effects = []>, #schedule.fragment<id = 8, function = @unit_5, block = 1, region = active, action = suspend_edge, tier = native, cost = 1, lane = 0, twoState = true, effects = [#schedule.effect<effect = watch, resource = storage, target = descriptor, descriptor = 0, formal = 0, low = 0, width = 1, dynamic = false, deferred = false, trigger = posedge>]>, #schedule.fragment<id = 9, function = @unit_5, block = 2, region = active, action = continue, tier = native, cost = 11, lane = 0, twoState = false, effects = [#schedule.effect<effect = read, resource = storage, target = descriptor, descriptor = 1, formal = 0, low = 0, width = 8, dynamic = false, deferred = false, trigger = none>, #schedule.effect<effect = nba, resource = storage, target = descriptor, descriptor = 1, formal = 0, low = 0, width = 8, dynamic = false, deferred = false, trigger = none>]>, #schedule.fragment<id = 10, function = @unit_6, block = 0, region = active, action = terminate, tier = native, cost = 37, lane = 0, twoState = false, effects = [#schedule.effect<effect = read, resource = storage, target = descriptor, descriptor = 1, formal = 0, low = 0, width = 8, dynamic = false, deferred = false, trigger = none>, #s