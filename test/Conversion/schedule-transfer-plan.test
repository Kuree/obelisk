// The sharing decision is printable before state accesses or wait CFGs expand.
// RUN: talos-opt %S/simulation-copy-process-admission.mlir --pass-pipeline='builtin.module(prepare-native-schedule-inputs,schedule-plan-native-state,prepare-native-process-frames,schedule-plan-native-transfers)' > %t.plan
// RUN: talos-opt %t.plan --schedule-share-native-transfers > %t.shared
// RUN: FileCheck %s < %t.shared
// RUN: talos-opt %t.shared --schedule-share-native-transfers | diff -u %t.shared -
// RUN: talos-opt %t.shared --pass-pipeline='builtin.module(schedule-plan-native-actors,schedule-specialize-native-captures,convert-simulation-to-native-schedule,prepare-native-managed-roots,schedule-mark-clean-native-nba,schedule-specialize-native-eval,schedule-prepare-native-transfer-kernels,schedule-annotate-compact-nba,prepare-native-fragments,schedule-plan-native-eval-ownership,schedule-annotate-compact-nba,schedule-plan-native-executable-nodes,schedule-resolve-native-eval,materialize-native-processes,convert-prepared-sim-processes-to-llvm-coroutines)' > %t.replayed
// RUN: talos-opt %S/simulation-copy-process-admission.mlir --convert-talos-sim-processes-to-llvm-coroutines | diff -u - %t.replayed
// RUN: not talos-opt %t.shared --pass-pipeline='builtin.module(test-talos-edit-attributes{match={source = 1 : i32} set={source = 2 : i32}},schedule-plan-native-actors,schedule-specialize-native-captures,convert-simulation-to-native-schedule,prepare-native-managed-roots,schedule-mark-clean-native-nba,schedule-specialize-native-eval,schedule-prepare-native-transfer-kernels,schedule-annotate-compact-nba,prepare-native-fragments,schedule-plan-native-eval-ownership,schedule-annotate-compact-nba,schedule-plan-native-executable-nodes,schedule-resolve-native-eval,materialize-native-processes,convert-prepared-sim-processes-to-llvm-coroutines)' 2>&1 | FileCheck %s --check-prefix=STALE
// STALE: transfer plan disagrees with canonical copy proof
// CHECK: schedule.transfer.activation
// CHECK-SAME: actor = @copies::@input_copy
// CHECK-SAME: kernel = @__talos_transfer_kernel_0
// CHECK: schedule.transfer.activation
// CHECK-SAME: actor = @copies::@output_copy
// CHECK-SAME: kernel = @__talos_transfer_kernel_0
// CHECK: schedule.transfer.activation
// CHECK-SAME: actor = @copies::@continuous_copy
// CHECK-SAME: kernel = @__talos_transfer_kernel_0
// CHECK-NOT: schedule.transfer.activation
// CHECK: schedule.transfer.kernel
// CHECK-SAME: source = 1 : i32
// CHECK-SAME: sym_name = "__talos_transfer_kernel_0"
// CHECK-NOT: schedule.transfer.kernel
