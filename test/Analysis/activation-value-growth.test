// RUN: %python %S/Inputs/gen-activation-value-chain.py > %t.mlir
// RUN: obelisk-opt %t.mlir '--test-obelisk-activation-regions=input-dependencies=true inputs=true' -o /dev/null 2>&1 | FileCheck %s --check-prefix=INPUT
// RUN: obelisk-opt %t.mlir '--test-obelisk-activation-regions=reaching-values=true inputs=true' -o /dev/null 2>&1 | FileCheck %s --check-prefix=FULL
// The generator asserts a linear node budget, independent of timing or memory.
// The entry load's data must still influence all the conditional publications.
// INPUT: inputs valid=1
// INPUT-NEXT: value-input s128[0,1){{$}}
// FULL: values valid=1
// FULL-NEXT: value-input s128[0,1){{$}}
// FULL-NEXT: final-input s128[0,1){{$}}
