// RUN: talos-translate --import-sdf %s | FileCheck %s
// RUN: talos-translate --import-sdf %s | talos-opt | FileCheck %s

(DELAYFILE
  (SDFVERSION "4.0")
  (TIMESCALE 1ns)
  (CELL
    (CELLTYPE "dut")
    (INSTANCE top.middle.leaf)))

// Preserve the SDF default dotted hierarchy text in transient IR. Per IEEE
// 1800-2017 32.4, matching remains an annotator/frontend concern and adds no
// runtime hierarchy lookup.
// CHECK: talos_sdf.delay_file
// CHECK-NOT: divider =
// CHECK: talos_sdf.cell
// CHECK-SAME: instance "top.middle.leaf"
