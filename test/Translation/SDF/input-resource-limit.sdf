// RUN: not obelisk-translate --import-sdf --sdf-max-input-bytes=16 %s -o %t.mlir 2>&1 | FileCheck %s
// RUN: test ! -e %t.mlir

// Clause 32 admits external annotation files, but the test-only translator
// and production frontend share a deterministic bounded importer.
// CHECK: error: SDF input exceeds the supported 16-byte limit

(DELAYFILE (SDFVERSION "4.0"))
