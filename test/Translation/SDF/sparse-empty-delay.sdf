// RUN: talos-translate --import-sdf %s | FileCheck %s
// RUN: talos-translate --import-sdf %s | talos-opt | FileCheck %s

(DELAYFILE
  (SDFVERSION "4.0")
  (TIMESCALE 1ns)
  (CELL
    (CELLTYPE "dut")
    (INSTANCE)
    (DELAY
      (ABSOLUTE
        (IOPATH a z ())
        (IOPATH a z (2) ())
        (IOPATH a z (2) () (4))
        (IOPATH a z (2) () (4) () (6) ())
        (IOPATH a z (2) () (4) () (6) () (8) () (10) () (12) ())
        (IOPATH a z (::))))))

// IEEE 1800-2017 32.3 gives both forms retention behavior, but normalization
// and textual roundtrip must preserve whether a tuple was written.
// CHECK: sdf.cell
// CHECK-NEXT: sdf.path_delay absolute iopath {{.*}}delays [#sdf.delay_value<form = empty>]
// CHECK-NEXT: sdf.path_delay absolute iopath {{.*}}delays [#sdf.delay_value<form = scalar, typ = <"2">>, #sdf.delay_value<form = empty>]
// CHECK-NEXT: sdf.path_delay absolute iopath {{.*}}delays [#sdf.delay_value<form = scalar, typ = <"2">>, #sdf.delay_value<form = empty>, #sdf.delay_value<form = scalar, typ = <"4">>]
// CHECK-NEXT: sdf.path_delay absolute iopath {{.*}}delays [#sdf.delay_value<form = scalar, typ = <"2">>, #sdf.delay_value<form = empty>, #sdf.delay_value<form = scalar, typ = <"4">>, #sdf.delay_value<form = empty>, #sdf.delay_value<form = scalar, typ = <"6">>, #sdf.delay_value<form = empty>]
// CHECK-NEXT: sdf.path_delay absolute iopath {{.*}}delays [#sdf.delay_value<form = scalar, typ = <"2">>, #sdf.delay_value<form = empty>, #sdf.delay_value<form = scalar, typ = <"4">>, #sdf.delay_value<form = empty>, #sdf.delay_value<form = scalar, typ = <"6">>, #sdf.delay_value<form = empty>, #sdf.delay_value<form = scalar, typ = <"8">>, #sdf.delay_value<form = empty>, #sdf.delay_value<form = scalar, typ = <"10">>, #sdf.delay_value<form = empty>, #sdf.delay_value<form = scalar, typ = <"12">>, #sdf.delay_value<form = empty>]
// CHECK-NEXT: sdf.path_delay absolute iopath {{.*}} to #sdf.port<name = "z", hasIndex = false, index = 0, edge = none> delays [#sdf.delay_value<form = triple>]
// CHECK-NEXT: }
