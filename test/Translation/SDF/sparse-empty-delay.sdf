// RUN: talos-translate --import-sdf %s | FileCheck %s
// RUN: talos-translate --import-sdf %s | talos-opt | FileCheck %s

(DELAYFILE
  (SDFVERSION "4.0")
  (TIMESCALE 1ns)
  (CELL
    (CELLTYPE "dut")
    (INSTANCE)
    (DELAY
      (ABSOLUTE
        (IOPATH a z ())
        (IOPATH a z (2) ())
        (IOPATH a z (2) () (4))
        (IOPATH a z (2) () (4) () (6) ())
        (IOPATH a z (2) () (4) () (6) () (8) () (10) () (12) ())
        (IOPATH a z (::))))))

// IEEE 1800-2017 32.3 gives both forms retention behavior, but normalization
// and textual roundtrip must preserve whether a tuple was written.
// CHECK: talos_sdf.cell
// CHECK-NEXT: talos_sdf.path_delay absolute iopath {{.*}}delays [#talos_sdf.delay_value<form = empty>]
// CHECK-NEXT: talos_sdf.path_delay absolute iopath {{.*}}delays [#talos_sdf.delay_value<form = scalar, typ = <"2">>, #talos_sdf.delay_value<form = empty>]
// CHECK-NEXT: talos_sdf.path_delay absolute iopath {{.*}}delays [#talos_sdf.delay_value<form = scalar, typ = <"2">>, #talos_sdf.delay_value<form = empty>, #talos_sdf.delay_value<form = scalar, typ = <"4">>]
// CHECK-NEXT: talos_sdf.path_delay absolute iopath {{.*}}delays [#talos_sdf.delay_value<form = scalar, typ = <"2">>, #talos_sdf.delay_value<form = empty>, #talos_sdf.delay_value<form = scalar, typ = <"4">>, #talos_sdf.delay_value<form = empty>, #talos_sdf.delay_value<form = scalar, typ = <"6">>, #talos_sdf.delay_value<form = empty>]
// CHECK-NEXT: talos_sdf.path_delay absolute iopath {{.*}}delays [#talos_sdf.delay_value<form = scalar, typ = <"2">>, #talos_sdf.delay_value<form = empty>, #talos_sdf.delay_value<form = scalar, typ = <"4">>, #talos_sdf.delay_value<form = empty>, #talos_sdf.delay_value<form = scalar, typ = <"6">>, #talos_sdf.delay_value<form = empty>, #talos_sdf.delay_value<form = scalar, typ = <"8">>, #talos_sdf.delay_value<form = empty>, #talos_sdf.delay_value<form = scalar, typ = <"10">>, #talos_sdf.delay_value<form = empty>, #talos_sdf.delay_value<form = scalar, typ = <"12">>, #talos_sdf.delay_value<form = empty>]
// CHECK-NEXT: talos_sdf.path_delay absolute iopath {{.*}} to #talos_sdf.port<name = "z", hasIndex = false, index = 0, edge = none> delays [#talos_sdf.delay_value<form = triple>]
// CHECK-NEXT: }
