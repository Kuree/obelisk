// RUN: obelisk-translate --import-sdf %s | FileCheck %s
// RUN: obelisk-translate --import-sdf %s | obelisk-opt | FileCheck %s

(DELAYFILE
  (SDFVERSION "4.0")
  (TIMESCALE 1ns)
  (CELL
    (CELLTYPE "dut")
    (INSTANCE)
    (DELAY
      (ABSOLUTE
        (IOPATH a z ())
        (IOPATH a z (2) ())
        (IOPATH a z (2) () (4))
        (IOPATH a z (2) () (4) () (6) ())
        (IOPATH a z (2) () (4) () (6) () (8) () (10) () (12) ())
        (IOPATH a z (::))))))

// IEEE 1800-2017 32.3 gives both forms retention behavior, but normalization
// and textual roundtrip must preserve whether a tuple was written.
// CHECK: obelisk_sdf.cell
// CHECK-NEXT: obelisk_sdf.path_delay {delays = [#obelisk_sdf.delay_value<form = empty>]
// CHECK-NEXT: obelisk_sdf.path_delay {delays = [#obelisk_sdf.delay_value<form = scalar, typ = <"2">>, #obelisk_sdf.delay_value<form = empty>]
// CHECK-NEXT: obelisk_sdf.path_delay {delays = [#obelisk_sdf.delay_value<form = scalar, typ = <"2">>, #obelisk_sdf.delay_value<form = empty>, #obelisk_sdf.delay_value<form = scalar, typ = <"4">>]
// CHECK-NEXT: obelisk_sdf.path_delay {delays = [#obelisk_sdf.delay_value<form = scalar, typ = <"2">>, #obelisk_sdf.delay_value<form = empty>, #obelisk_sdf.delay_value<form = scalar, typ = <"4">>, #obelisk_sdf.delay_value<form = empty>, #obelisk_sdf.delay_value<form = scalar, typ = <"6">>, #obelisk_sdf.delay_value<form = empty>]
// CHECK-NEXT: obelisk_sdf.path_delay {delays = [#obelisk_sdf.delay_value<form = scalar, typ = <"2">>, #obelisk_sdf.delay_value<form = empty>, #obelisk_sdf.delay_value<form = scalar, typ = <"4">>, #obelisk_sdf.delay_value<form = empty>, #obelisk_sdf.delay_value<form = scalar, typ = <"6">>, #obelisk_sdf.delay_value<form = empty>, #obelisk_sdf.delay_value<form = scalar, typ = <"8">>, #obelisk_sdf.delay_value<form = empty>, #obelisk_sdf.delay_value<form = scalar, typ = <"10">>, #obelisk_sdf.delay_value<form = empty>, #obelisk_sdf.delay_value<form = scalar, typ = <"12">>, #obelisk_sdf.delay_value<form = empty>]
// CHECK-NEXT: obelisk_sdf.path_delay {delays = [#obelisk_sdf.delay_value<form = triple>]
// CHECK-SAME: output = #obelisk_sdf.port<name = "z", hasIndex = false, index = 0, edge = none>}
// CHECK-NEXT: }
