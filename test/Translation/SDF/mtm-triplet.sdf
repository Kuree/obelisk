// RUN: obelisk-translate --import-sdf %s | FileCheck %s
// RUN: obelisk-translate --import-sdf %s | obelisk-opt | FileCheck %s

(DELAYFILE
  (SDFVERSION "4.0")
  (TIMESCALE 1ns)
  (CELL
    (CELLTYPE "mtm_cell")
    (INSTANCE dut)
    (DELAY
      (ABSOLUTE
        (IOPATH source destination (1.25:2.5:3.75) (::6))))))

// IEEE 1800-2017 32.9: the transient import boundary preserves all three
// exact members; per-call MTM selection belongs to production consumption.
// CHECK: obelisk_sdf.path_delay
// CHECK-SAME: delays = [#obelisk_sdf.delay_value<form = triple, min = <"1.25">, typ = <"2.5">, max = <"3.75">>, #obelisk_sdf.delay_value<form = triple, max = <"6">>]
// CHECK-NOT: obelisk_sim
// CHECK-NOT: obelisk_rt
