// RUN: talos-translate --import-sdf %s | FileCheck %s
// RUN: talos-translate --import-sdf %s | talos-opt | FileCheck %s

(DELAYFILE
  (SDFVERSION "4.0")
  (TIMESCALE 1 ns)
  (CELL
    (CELLTYPE "sdf_aot_static")
    (INSTANCE)
    (DELAY (ABSOLUTE))))

// CHECK: sdf.delay_file
// CHECK-SAME: version "4.0"
// CHECK-SAME: timescale = #sdf.timescale<amount = <"1">, unit = ns>
// CHECK: sdf.cell
// CHECK-SAME: "sdf_aot_static"
