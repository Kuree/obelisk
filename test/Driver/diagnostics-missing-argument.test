// Frontend options that take a value diagnose a missing argument.
// RUN: not talos -D 2>&1 | FileCheck %s --check-prefix=MISSING
// RUN: not talos -U 2>&1 | FileCheck %s --check-prefix=MISSING
// RUN: not talos -I 2>&1 | FileCheck %s --check-prefix=MISSING
// RUN: not talos --include-directory 2>&1 | FileCheck %s --check-prefix=MISSING
// RUN: not talos -isystem 2>&1 | FileCheck %s --check-prefix=MISSING
// RUN: not talos -y 2>&1 | FileCheck %s --check-prefix=MISSING
// RUN: not talos -Y 2>&1 | FileCheck %s --check-prefix=MISSING
// RUN: not talos -l 2>&1 | FileCheck %s --check-prefix=MISSING

// MISSING: talos: error:
// MISSING-SAME: missing argument
