// LLVM optimization follows -O for optimization.sv, and threaded compilation of
// the same input is deterministic.
// RUN: obelisk -O1 -emit-sim --compile-threads=1 %S/optimization.sv > %t.o1.single
// RUN: obelisk -O1 -emit-sim --compile-threads=4 %S/optimization.sv > %t.o1.threaded
// RUN: diff -u %t.o1.single %t.o1.threaded
// RUN: obelisk -O0 -emit-llvm %S/optimization.sv | FileCheck %S/optimization.sv --check-prefix=LLVM-O0
// RUN: obelisk -O1 -emit-llvm %S/optimization.sv | FileCheck %S/optimization.sv --check-prefix=LLVM-OPT
// RUN: obelisk -O2 -emit-llvm %S/optimization.sv | FileCheck %S/optimization.sv --check-prefix=LLVM-OPT
// RUN: obelisk -O3 -emit-llvm %S/optimization.sv | FileCheck %S/optimization.sv --check-prefix=LLVM-O3
