// REQUIRES: native-elf
// The bytecode tier reads the nets of native-vpi-net-backdoor.sv through the
// same VPI probe library.
// RUN: mkdir -p %t.dir/lib %t.dir/bin
// RUN: %target_clang -fPIC -shared -nostdlib %S/Inputs/vpi_net_probe.c -I%resource_dir/include -Wl,-soname,libtalos_vpi_net_probe.so -o %t.dir/lib/libtalos_vpi_net_probe.so
// RUN: cd %t.dir && talos --execution-tier=bytecode --vpi=read %S/native-vpi-net-backdoor.sv lib/libtalos_vpi_net_probe.so -o bin/read-bytecode
// RUN: %t.dir/bin/read-bytecode | FileCheck %S/native-vpi-net-backdoor.sv
