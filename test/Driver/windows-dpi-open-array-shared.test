// REQUIRES: windows
// RUN: %split-file %S/Inputs/windows-pi.defs %t.dir
// RUN: %llvm_dist/bin/llvm-dlltool -m %dlltool_machine -D simulator.exe -d %native_support/talos-pi.def -l %t.dir/host.lib
// RUN: %target_clang -fuse-ld=lld -shared %S/Inputs/dpi_open_array_impl.c -I%resource_dir/include %t.dir/host.lib -Xlinker /export:inspect_arrays -Xlinker /export:inspect_dynamic -o %t.dir/array.dll
// RUN: talos %S/dpi-open-array.sv %t.dir/array.dll -o %t.dir/simulator.exe
// RUN: %t.dir/simulator.exe | FileCheck %S/dpi-open-array.sv
// RUN: talos --execution-tier=bytecode %S/dpi-open-array.sv %t.dir/array.dll -o %t.dir/simulator.exe
// RUN: %t.dir/simulator.exe | FileCheck %S/dpi-open-array.sv
