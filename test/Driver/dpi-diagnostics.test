// RUN: %target_clang -fPIC -c %S/Inputs/dpi_impl.c -I%resource_dir/include -o %t.o
// RUN: not obelisk --dpi-link=%t.o %S/dpi.sv -o %t.removed 2>&1 | FileCheck %s --check-prefix=REMOVED
// RUN: not obelisk %t.o -o %t.native-only 2>&1 | FileCheck %s --check-prefix=NATIVE-ONLY
// RUN: %target_clang -fPIC -flto=full -c %S/Inputs/dpi_impl.c -I%resource_dir/include -o %t.incompatible.bc
// RUN: not obelisk -flto %S/dpi.sv %t.incompatible.bc -o %t.incompatible 2>&1 | FileCheck %s --check-prefix=INCOMPATIBLE
// RUN: %target_clang -nostdlib -shared %t.o -Wl,-soname,bad/name.so -o %t.bad-soname.so
// RUN: not obelisk %S/dpi.sv %t.bad-soname.so -o %t.bad-soname 2>&1 | FileCheck %s --check-prefix=BAD-SONAME
// RUN: not obelisk %S/dpi.sv -o %t.missing 2>&1 | FileCheck %s --check-prefix=MISSING

// Shared-library loader identities are diagnosed in
// dpi-shared-library-diagnostics.test.
// LTO bitcode that is not unified LTO bitcode is rejected before the link
// spends time optimizing the whole program.
// INCOMPATIBLE: obelisk: error: LTO input '{{.*}}.incompatible.bc' is not unified LTO bitcode; compile it with -funified-lto
// INCOMPATIBLE-NOT: ld.lld
// BAD-SONAME: has a DT_SONAME containing '/'
// REMOVED: unknown argument '--dpi-link=
// NATIVE-ONLY: at least one SystemVerilog input or command file is required
// MISSING-DAG: undefined symbol: dpi_add
// MISSING-DAG: undefined symbol: dpi_scalars
// MISSING-DAG: undefined symbol: dpi_update
// MISSING-DAG: undefined symbol: dpi_unused
// MISSING-DAG: undefined symbol: dpi_logic_inout
// MISSING-DAG: undefined symbol: dpi_void
// MISSING-DAG: undefined symbol: dpi_reals
