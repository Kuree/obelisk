// Elaboration options: top modules and parameters, time scale, constants,
// declaration order, unknown modules, diagnostics, and slang passthrough.
// RUN: obelisk -emit-slang --top=selected_top -G WIDTH=12 %S/Inputs/tops.sv | FileCheck %s --check-prefix=TOP
// RUN: obelisk -emit-slang --timescale=10ns/1ns %S/Inputs/timescale.sv | FileCheck %s --check-prefix=TIMESCALE
// RUN: obelisk -emit-slang %S/Inputs/exact_constants.sv | FileCheck %s --check-prefix=EXACT-CONSTANT
// RUN: obelisk -emit-slang --allow-use-before-declare %S/Inputs/use_before_declare.sv | FileCheck %s --check-prefix=USE-BEFORE-DECLARE
// RUN: obelisk -emit-slang --ignore-unknown-modules %S/Inputs/macros.sv | FileCheck %s --check-prefix=IGNORE-UNKNOWN
// RUN: obelisk -emit-slang -Wno-unused --error-limit=5 --suppress-warnings=%S/Inputs %S/Inputs/macros.sv | FileCheck %s --check-prefix=DIAGNOSTICS
// RUN: obelisk -emit-slang -Xslang --ignore-unknown-modules %S/Inputs/macros.sv | FileCheck %s --check-prefix=XSLANG

// TOP: hierarchical_name = "selected_top"
// TOP: !slang.packed_array<11 : 0 x
// TOP-NOT: @unused_top
// TIMESCALE: slang.timing.delay
// TIMESCALE: slang.expression.integer_literal
// TIMESCALE: slang.expression.time_literal attributes {constant_value = "0.12345678901234561"
// TIMESCALE-SAME: time_scale = "10ns / 1ns"
// EXACT-CONSTANT: constant_value = "160'b10xz10xz10xz10xz10xz10xz10xz10xz10xz10xz10xz10xz10xz10xz10xz10xz10xz10xz10xz10xz10xz10xz10xz10xz10xz10xz10xz10xz10xz10xz10xz10xz10xz10xz10xz10xz10xz10xz10xz10xz"
// EXACT-CONSTANT-NOT: ...
// USE-BEFORE-DECLARE: hierarchical_name = "use_before_declare"
// IGNORE-UNKNOWN: hierarchical_name = "macro_was_undefined"
// DIAGNOSTICS: hierarchical_name = "macro_was_undefined"
// XSLANG: hierarchical_name = "macro_was_undefined"
