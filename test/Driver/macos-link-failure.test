// REQUIRES: native-macho
// RUN: %split-file %s %t.dir
// RUN: %obelisk %S/macos-native.sv -o %t.dir/simulator
// RUN: not %obelisk %t.dir/missing.sv -o %t.dir/simulator 2>&1 | FileCheck %s
// RUN: %t.dir/simulator | FileCheck %S/macos-native.sv --check-prefix=OUTPUT

// An unresolved strong symbol must fail without replacing an existing output.
// Optional weak runtime services must not weaken this diagnostic.
// CHECK: undefined symbol: _missing_link_symbol

//--- missing.sv
module missing;
  import "DPI-C" function int missing_link_symbol(input int value);
  initial $display("%0d", missing_link_symbol(42));
endmodule
