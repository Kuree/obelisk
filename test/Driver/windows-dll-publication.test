// REQUIRES: windows
// RUN: %split-file %s %t.dir
// RUN: %target_clang -fuse-ld=lld -shared %t.dir/impl.c -Wl,/export:dpi_add -o %t.dir/dpi.dll
// RUN: mkdir -p %t.dir/bundle/simulator.exe
// RUN: cp %s %t.dir/bundle/dpi.dll
// RUN: not talos %t.dir/design.sv %t.dir/dpi.dll -o %t.dir/bundle/simulator.exe 2>&1 | FileCheck %s
// RUN: diff -u %s %t.dir/bundle/dpi.dll

// A directory prevents EXE publication after its companions were staged. The
// sentinel copied above must be restored, preserving an existing bundle.
// CHECK: error: could not publish '{{.*}}simulator.exe':

//--- design.sv
module publication;
  import "DPI-C" pure function int dpi_add(input int value);
  initial $display("%0d", dpi_add(37));
endmodule
//--- impl.c
int dpi_add(int value) { return value + 5; }
