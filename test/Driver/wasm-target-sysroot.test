// Incomplete or mismatched wasm32 sysroots are diagnosed before linking. The
// sysroot trees are split from wasm-target.sv; the relocated compilers are
// hard links, which find their resources beside the link, not the original.
// RUN: %split-file %S/wasm-target.sv %t
// RUN: ln -f %talos %t/no-runtime/bin/talos
// RUN: ln -f %talos %t/no-libs/bin/talos
// RUN: not %t/no-runtime/bin/talos --target=wasm32 -O0 --sysroot=%t/missing %S/wasm-target.sv -o %t/missing.wasm 2>&1 | FileCheck %S/wasm-target.sv --check-prefix=MISSING-SYSROOT
// RUN: not %t/no-runtime/bin/talos --target=wasm32 -O0 --sysroot=%t/wasm64-sysroot %S/wasm-target.sv -o %t/wasm64.wasm 2>&1 | FileCheck %S/wasm-target.sv --check-prefix=WASM64-SYSROOT
// RUN: not %t/no-runtime/bin/talos --target=wasm32 -O0 --sysroot=%t/no-runtime-sysroot %S/wasm-target.sv -o %t/no-runtime.wasm 2>&1 | FileCheck %S/wasm-target.sv --check-prefix=MISSING-RUNTIME
// RUN: not %t/no-libs/bin/talos --target=wasm32 -O0 --sysroot=%t/no-libs-sysroot %S/wasm-target.sv -o %t/no-libs.wasm 2>&1 | FileCheck %S/wasm-target.sv --check-prefix=MISSING-LIBS
