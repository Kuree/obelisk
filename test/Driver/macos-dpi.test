// RUN: cd %t.dir && %obelisk -flto %S/dpi.sv lib/libdpi.dylib -o bin/simulator-lto && ./bin/simulator-lto | FileCheck %S/dpi-shared.test --check-prefix=OUTPUT
// RUN: %llvm_dist/bin/llvm-objdump --macho --private-headers %t.dir/bin/simulator | FileCheck %s
