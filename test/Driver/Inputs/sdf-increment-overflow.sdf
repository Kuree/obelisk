(DELAYFILE
  (SDFVERSION "4.0")
  (TIMESCALE 1fs)
  (CELL
    (CELLTYPE "sdf_increment_overflow_cell")
    (INSTANCE over)
    (DELAY (INCREMENT (IOPATH source destination (10)))))
  (CELL
    (CELLTYPE "sdf_increment_underflow_cell")
    (INSTANCE under)
    (DELAY (INCREMENT
      (IOPATH source destination (-9223372036854775808))))))
