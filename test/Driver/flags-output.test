// Output selection: -o, debug locations, inputs after --, standard input, and
// the last action option, which controls the representation that is emitted.
// RUN: talos -emit-slang -o %t %S/Inputs/macros.sv
// RUN: FileCheck %s --check-prefix=OUTPUT --input-file=%t
// RUN: talos -emit-slang --mlir-print-debuginfo %S/Inputs/macros.sv | FileCheck %s --check-prefix=DEBUG
// RUN: cd %S/Inputs && talos -emit-slang -- -dash_input.sv | FileCheck %s --check-prefix=DASH-DASH
// RUN: talos -emit-slang - < %S/Inputs/macros.sv | FileCheck %s --check-prefix=STDIN
// RUN: talos -emit-talos -emit-slang %S/Inputs/macros.sv | FileCheck %s --check-prefix=LAST-SLANG
// RUN: talos -emit-slang -emit-talos %S/Inputs/macros.sv | FileCheck %s --check-prefix=LAST-TALOS

// OUTPUT: slang.symbol.instance @{{[^ ]+}} attributes {{.*}}hierarchical_name = "macro_was_undefined"
// DEBUG: slang.symbol.instance @{{[^ ]+}} attributes {{.*}}hierarchical_name = "macro_was_undefined"
// DEBUG: loc(
// DASH-DASH: hierarchical_name = "dash_dash_input"
// STDIN: hierarchical_name = "macro_was_undefined"
// LAST-SLANG: slang.symbol.instance @{{[^ ]+}} attributes {{.*}}hierarchical_name = "macro_was_undefined"
// LAST-SLANG-NOT: talos.
// LAST-TALOS: talos.sv.symbol.instance @{{[^ ]+}} attributes {{.*}}hierarchical_name = "macro_was_undefined"
// LAST-TALOS-NOT: slang.
