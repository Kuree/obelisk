// REQUIRES: windows
// RUN: %split-file %S/Inputs/windows-pi.defs %t.dir
// RUN: %llvm_dist/bin/llvm-dlltool -m %dlltool_machine -D simulator.exe -d %native_support/obelisk-pi.def -l %t.dir/host.lib
// RUN: %target_clang -fuse-ld=lld -shared %S/Inputs/vpi_startup.c -I%resource_dir/include %t.dir/host.lib -Xlinker /def:%t.dir/vpi.def -o %t.dir/first.dll
// RUN: %target_clang -fuse-ld=lld -shared %S/Inputs/vpi_startup_second.c -I%resource_dir/include %t.dir/host.lib -Xlinker /export:vlog_startup_routines,data -o %t.dir/second.dll
// RUN: obelisk --execution-tier=bytecode --vpi=full %S/vpi.sv %t.dir/first.dll %t.dir/second.dll -o %t.dir/simulator.exe
// RUN: %t.dir/simulator.exe | FileCheck %S/vpi.sv --check-prefix=OUTPUT
