// Protected envelopes need a provider and respect the protect size and count
// limits (inputs in protected-envelope-hook.sv).
// RUN: not obelisk -emit-slang %S/protected-envelope-hook.sv 2>&1 | FileCheck %S/protected-envelope-hook.sv --check-prefix=NO-PROVIDER
// RUN: not %protect-obelisk --test-max-protect-bytes=8 -emit-slang %S/protected-envelope-hook.sv 2>&1 | FileCheck %S/protected-envelope-hook.sv --check-prefix=SIZE-LIMIT
// RUN: not %protect-obelisk --test-max-protect-count=0 -emit-slang %S/protected-envelope-hook.sv 2>&1 | FileCheck %S/protected-envelope-hook.sv --check-prefix=COUNT-LIMIT
